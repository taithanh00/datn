<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sen Há»“ng</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />

    <script>
        (function(){
            var t = localStorage.getItem('senhong-theme');
            if (t) document.documentElement.setAttribute('data-theme', t);
            else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-container">
        <aside class="sidebar" id="sidebar">
            <a href="/" class="sidebar-header" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px;">
                <i class="fa-solid fa-spa" style="font-size:1.4rem; color: #e91e63;"></i>
                <span>Sen Há»“ng</span>
            </a>

            <nav class="sidebar-nav">
                <a href="/" class="nav-item" data-transition>
                    <i class="fa-solid fa-chart-line"></i> Tá»•ng quan
                </a>

                @if (ViewBag.Role == "Manager")
                {
                    <div class="nav-label">Quáº£n trá»‹ há»‡ thá»‘ng</div>
                    <a href="/Manager/Classes" class="nav-item" data-transition><i class="fa-solid fa-school"></i> Quáº£n lÃ½ lá»›p há»c</a>
                    <a href="/Manager/Subjects" class="nav-item" data-transition><i class="fa-solid fa-book"></i> Danh mục môn học</a>
                    <a href="/Manager/Schedules" class="nav-item" data-transition><i class="fa-solid fa-calendar-days"></i> Thá»i khÃ³a biá»ƒu</a>
                    <a href="/Manager/Students" class="nav-item" data-transition><i class="fa-solid fa-user-graduate"></i> Học sinh</a>
                    <a href="/Manager/Parents" class="nav-item" data-transition><i class="fa-solid fa-users-viewfinder"></i> Phụ huynh</a>
                    <a href="/Manager/Teachers" class="nav-item" data-transition><i class="fa-solid fa-user-tie"></i> Giáo viên</a>
                    <!-- <a href="/Manager/TeacherContracts" class="nav-item" data-transition><i class="fa-solid fa-file-contract"></i> Há»£p Ä‘á»“ng giÃ¡o viÃªn</a> -->
                    <a href="/HolidayManagement" class="nav-item" data-transition><i class="fa-solid fa-umbrella-beach"></i> NgÃ y lá»…</a>
                    <a href="/Manager/Activities" class="nav-item" data-transition><i class="fa-solid fa-calendar-check"></i> Hoáº¡t Ä‘á»™ng</a>
                    <a href="/Manager/Nutrition" class="nav-item" data-transition><i class="fa-solid fa-utensils"></i> Quản lý Dinh dưỡng</a>
                    <a href="/Manager/SystemLog" class="nav-item" data-transition><i class="fa-solid fa-clock-rotate-left"></i> Nháº­t kÃ½ há»‡ thá»‘ng</a>

                    <div class="nav-label">Đào tạo</div>
                    <a href="/Manager/Assignments" class="nav-item" data-transition><i class="fa-solid fa-calendar-days"></i> Phân công giảng dạy</a>

                    <div class="nav-label">Tài chính</div>
                    <a href="/Tuition" class="nav-item" data-transition><i class="fa-solid fa-file-invoice-dollar"></i> Học phí</a>
                    <a href="/TeacherSalary" class="nav-item" data-transition><i class="fa-solid fa-money-check-dollar"></i> Tiền lương</a>

                    <div class="nav-label">PhÃª duyá»‡t</div>
                    <a href="/LeaveApproval" class="nav-item" data-transition><i class="fa-solid fa-clipboard-check"></i> Duyá»‡t nghá»‰ phÃ©p</a>
                }

                @if (ViewBag.Role == "Employee")
                {
                    <div class="nav-label">Giảng dạy</div>
                    <a href="/Employee/Classes" class="nav-item" data-transition><i class="fa-solid fa-chalkboard-user"></i> Lá»›p cá»§a tÃ´i</a>
                    <a href="/Employee/Attendance" class="nav-item" data-transition><i class="fa-solid fa-clipboard-user"></i> Äiá»ƒm danh</a>
                    <a href="/Employee/StudyReport" class="nav-item" data-transition><i class="fa-solid fa-file-signature"></i> Nhận xét & Báo cáo</a>
                    <a href="/Employee/Activities" class="nav-item @(ViewData["Title"]?.ToString() == "Hoáº¡t Ä‘á»™ng" ? "active" : "")" data-transition><i class="fa-solid fa-calendar-check"></i> Hoáº¡t Ä‘á»™ng</a>
                    <a href="/Employee/ClassReports" class="nav-item @(ViewData["Title"]?.ToString() == "Nháº­t kÃ½ lá»›p há»c" ? "active" : "")" data-transition><i class="fa-solid fa-book-open"></i> Nháº­t kÃ½ lá»›p há»c</a>
                    <a href="/Employee/Nutrition" class="nav-item @(ViewData["Title"]?.ToString() == "Quáº£n lÃ½ Dinh dÆ°á»¡ng & Thá»±c Ä‘Æ¡n" ? "active" : "")" data-transition><i class="fa-solid fa-utensils"></i> Dinh dÆ°á»¡ng vÃ  Thá»±c Ä‘Æ¡n</a>

                    <div class="nav-label">Cá nhân</div>
                    <a href="/Employee/TimeAttendance" class="nav-item" data-transition><i class="fa-solid fa-clock"></i> Chấm công</a>
                    <a href="/Employee/LeaveRequest" class="nav-item" data-transition><i class="fa-solid fa-calendar-minus"></i> Nghá»‰ phÃ©p</a>
                    <a href="/Employee/WorkSchedule" class="nav-item" data-transition><i class="fa-solid fa-calendar-days"></i> Lá»‹ch dáº¡y cÃ¡ nhÃ¢n</a>
                    <a href="/Employee/Holidays" class="nav-item" data-transition><i class="fa-solid fa-umbrella-beach"></i> NgÃ y lá»…</a>
                    <a href="/Employee/Salary" class="nav-item" data-transition><i class="fa-solid fa-wallet"></i> Phiếu lương</a>
                }

                @if (ViewBag.Role == "Parent")
                {
                    <div class="nav-label">Con của tôi</div>
                    <a href="/Parent/Children" class="nav-item" data-transition><i class="fa-solid fa-child"></i> Thông tin bé</a>
                    <a href="/Parent/AttendanceReport" class="nav-item" data-transition><i class="fa-solid fa-calendar-check"></i> Chuyên cần</a>
                    <a href="/Parent/StudyReports" class="nav-item" data-transition><i class="fa-solid fa-chart-bar"></i> Học tập</a>
                    <a href="/Parent/Activities" class="nav-item" data-transition><i class="fa-solid fa-puzzle-piece"></i> Hoáº¡t Ä‘á»™ng cá»§a bÃ©</a>
                    <a href="/Parent/DailyReport/MyChild" class="nav-item" data-transition><i class="fa-solid fa-notes-medical"></i> Nhật ký và Sức khỏe</a>
                    <a href="/Parent/Tuition/MyTuition" class="nav-item" data-transition><i class="fa-solid fa-wallet"></i> Học phí</a>
                }

                <div style="margin-top:auto; padding-top:20px; border-top:1px solid var(--border);">
                    <a href="/Account/Profile" class="nav-item" data-transition><i class="fa-solid fa-user-gear"></i> Tài khoản</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-item" style="width:100%; background:none; border:none; cursor:pointer; text-align:left; font-family:inherit; font-size:inherit; color:inherit;">
                            <i class="fa-solid fa-right-from-bracket"></i> ÄÄƒng xuáº¥t
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <div class="main-wrapper">
            <header class="header">
                <div class="header-left d-flex align-center gap-2">
                    <button class="hamburger" id="hamburgerBtn"><i class="fa-solid fa-bars"></i></button>
                    <div class="breadcrumb" style="font-size:0.9rem; margin-bottom:4px;">
                        <span style="color:var(--text-muted)">
                            @{
                                var ctrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                                var role = ViewBag.Role as string;
                                var localizedCtrl = ctrl switch
                                {
                                    "Account" => "Tài khoản",
                                    _ when role == "Manager" => "Quản lý",
                                    _ when role == "Employee" => "Giáo viên",
                                    _ when role == "Parent" => "Phụ huynh",
                                    "Manager" => "Quản lý",
                                    "Employee" => "Giáo viên",
                                    "Parent" => "Phụ huynh",
                                    "Nutrition" => "Dinh dưỡng",
                                    "Tuition" => "Học phí",
                                    "TeacherSalary" => "Lương giáo viên",
                                    "LeaveApproval" => "Duyệt nghỉ phép",
                                    "TimeAttendance" => "Chấm công",
                                    "LeaveRequest" => "Nghỉ phép",
                                    "DailyReport" => "Nhật ký",
                                    "WorkAttendance" => "Chấm công nhân sự",
                                    "PayrollPeriod" => "Kỳ lương",
                                    "Holidays" => "Ngày lễ",
                                    _ => ctrl
                                };
                                @localizedCtrl
                            }
                        </span> /
                        <span style="font-weight:600; color:var(--text-main)">@ViewData["Title"]</span>
                    </div>
                </div>
                <div class="header-right d-flex align-center gap-2">
                    <!-- Notifications -->
                    <div style="position:relative;">
                        <button class="theme-toggle" id="notificationToggle" style="position:relative;" data-tooltip-bottom="Thông báo">
                            <i class="fa-solid fa-bell"></i>
                            <span id="notificationCount" style="display:none; position:absolute; top:0; right:0; background:var(--danger); color:#fff; font-size:0.6rem; width:16px; height:16px; border-radius:50%; align-items:center; justify-content:center; font-weight:700;"></span>
                        </button>
                        <div id="notificationMenu" class="notification-dropdown">
                            <div style="padding:16px; font-weight:700; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:12px;">
                                <span>Thông báo</span>
                                <button id="markAllNotificationsReadBtn" type="button" class="btn-table" style="display:none; color:var(--primary); white-space:nowrap;">
                                    Đánh dấu tất cả đã đọc
                                </button>
                            </div>
                            <div id="notificationList" style="max-height:320px; overflow-y:auto; padding:8px;">
                                <div class="empty-state" style="padding:32px 16px;"><i class="fa-solid fa-bell-slash"></i><p>Không có thông báo</p></div>
                            </div>
                        </div>
                    </div>
                    <!-- Dark Mode -->
                    <button class="theme-toggle" id="themeToggle" data-tooltip-bottom="Giao diện">
                        <i class="fa-solid fa-moon"></i><i class="fa-solid fa-sun"></i>
                    </button>
                    <!-- User -->
                    <div style="position:relative;">
                        <div class="d-flex align-center gap-1" id="userProfileToggle" style="cursor:pointer; padding:4px; border-radius:8px; transition:background 0.2s;">
                            <div style="text-align:right;">
                                <div style="font-size:0.85rem; font-weight:600;">@ViewBag.FullName</div>
                                <div style="font-size:0.72rem; color:var(--text-muted);">
                                    @(ViewBag.Role == "Manager" ? "Quản lý" : ViewBag.Role == "Employee" ? "Giáo viên" : "Phụ huynh")
                                </div>
                            </div>
                            <img src="@ViewBag.UserAvatar"
                                 alt="Avatar" style="width:36px; height:36px; border-radius:50%; border:2px solid white; object-fit:cover;" onerror="this.src='/images/lion_blue.png'">
                            <i class="fa-solid fa-chevron-down" style="font-size:0.7rem; color:var(--text-muted); margin-left:4px;"></i>
                        </div>
                        <div id="userProfileMenu" class="notification-dropdown" style="width:200px; right:0; top:100%; margin-top:8px;">
                            <a href="/Account/Profile" class="notification-item" style="display:flex; align-items:center; gap:10px; padding:12px 16px; color:var(--text-main); text-decoration:none; border-bottom:1px solid var(--border);">
                                <i class="fa-solid fa-user-gear"></i>
                                <span>Thông tin người dùng</span>
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="notification-item" style="width:100%; display:flex; align-items:center; gap:10px; padding:12px 16px; background:none; border:none; cursor:pointer; color:var(--danger); font-size:inherit; font-family:inherit; text-align:left;">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span>ÄÄƒng xuáº¥t</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content-body page-wrapper">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" style="position:fixed; right:20px; top:80px; z-index:9999; display:flex; flex-direction:column; gap:8px;"></div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var userToggle = document.getElementById('userProfileToggle');
            var userMenu = document.getElementById('userProfileMenu');
            if(userToggle && userMenu) {
                userToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    userMenu.classList.toggle('active');
                });
                document.addEventListener('click', function(e) {
                    if (!userToggle.contains(e.target) && !userMenu.contains(e.target)) {
                        userMenu.classList.remove('active');
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
