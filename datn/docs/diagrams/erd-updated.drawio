        </mxCell>
        <mxCell id="legend" value="Ký hiệu: PK = Primary Key, FK = Foreign Key. Đường nối thể hiện quan hệ khóa ngoại.&#xa;Bảng mới dùng để cấu hình khoản thu áp dụng theo từng học sinh trong từng tháng/năm/lớp/khoản thu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="720" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="sec-core" value="HỌC SINH - PHỤ HUYNH - LỚP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1">
