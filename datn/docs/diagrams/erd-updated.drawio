        <mxCell id="title" value="SƠ ĐỒ ERD - HỆ THỐNG QUẢN LÝ TRƯỜNG MẦM NON SEN HỒNG&#xa;CẬP NHẬT BẢNG MONTHLY_STUDENT_FEE_ASSIGNMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;" vertex="1" parent="1">
