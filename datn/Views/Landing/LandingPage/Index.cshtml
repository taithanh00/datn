@{
    Layout = "~/Views/Common/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<section class="hero">
    <div class="container flex justify-between items-center">
        <div class="hero-content">
            <h1 class="hero-title">Nơi khởi đầu <span>Yêu thương</span> & Sáng tạo</h1>
            <p class="hero-desc">Mầm non SenHồng kiến tạo môi trường giáo dục hạnh phúc, giúp bé tự tin khám phá thế giới và phát triển tiềm năng vô hạn.</p>
            <div class="flex gap-4">
                <a href="#contact" class="btn btn-primary">Tìm hiểu ngay</a>
                <a href="#program" class="btn btn-outline">Xem chương trình</a>
            </div>
        </div>
        <div class="hero-image">
            <div class="image-blob">
                <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Happy kids" />
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="p-10" style="background: var(--bg-white);">
    <div class="container">
        <div class="grid grid-3 text-center">
            <div>
                <h2 style="font-size: 3rem; color: var(--primary);">500+</h2>
                <p class="text-muted">Học sinh tin tưởng</p>
            </div>
            <div>
                <h2 style="font-size: 3rem; color: var(--primary);">50+</h2>
                <p class="text-muted">Giáo viên tâm huyết</p>
            </div>
            <div>
                <h2 style="font-size: 3rem; color: var(--primary);">10+</h2>
                <p class="text-muted">Năm kinh nghiệm</p>
            </div>
        </div>
    </div>
</section>

<!-- Programs -->
<section id="program" class="p-10">
    <div class="container text-center">
        <h2 class="section-title">Chương trình giáo dục</h2>
        <p class="section-subtitle">Chúng tôi thiết kế lộ trình phát triển toàn diện, kết hợp giữa phương pháp truyền thống và hiện đại.</p>
        
        <div class="grid grid-3">
            <div class="program-card">
                <div class="card-icon"><i class="fa-solid fa-palette"></i></div>
                <h3 class="mb-2">Phát triển Năng khiếu</h3>
                <p class="text-muted">Khơi dậy niềm đam mê nghệ thuật, âm nhạc và hội họa ngay từ nhỏ.</p>
            </div>
            <div class="program-card">
                <div class="card-icon"><i class="fa-solid fa-brain"></i></div>
                <h3 class="mb-2">Tư duy Logic</h3>
                <p class="text-muted">Rèn luyện khả năng quan sát, phân tích thông qua các trò chơi trí tuệ.</p>
            </div>
            <div class="program-card">
                <div class="card-icon"><i class="fa-solid fa-heart"></i></div>
                <h3 class="mb-2">Kỹ năng Sống</h3>
                <p class="text-muted">Xây dựng thói quen tự lập và bồi dưỡng lòng nhân ái cho bé.</p>
            </div>
        </div>
    </div>
</section>

<!-- Consultation Form -->
<section id="contact" class="p-10" style="background: #fff5f8;">
    <div class="container text-center">
        <h2 class="section-title">Đăng ký tư vấn</h2>
        <p class="section-subtitle">Để lại thông tin, đội ngũ tuyển sinh của SenHồng sẽ liên hệ với bạn trong vòng 24h.</p>
        
        <div class="consultation-form" id="consultationFormSection">
            <div class="consultation-form-header">
                <div>
                    <h3 class="consultation-form-title">Đăng ký tư vấn</h3>
                    <p class="consultation-form-text">Bạn có thể thu gọn phần này nếu chỉ muốn tham khảo nội dung và mở rộng khi cần gửi yêu cầu.</p>
                </div>
                <button type="button" class="collapse-toggle" id="consultToggle" aria-expanded="true">
                    <span class="toggle-label">Thu gọn</span>
                    <i class="fa-solid fa-chevron-up"></i>
                </button>
            </div>
            <div class="consultation-form-body">
                <form id="consultForm">
                    <div class="grid grid-2 gap-4" style="grid-template-columns: 1fr 1fr; margin-bottom: 20px;">
                        <div class="form-group">
                            <label>Tên của bạn</label>
                            <input type="text" id="consultName" name="FullName" class="form-control" placeholder="Nhập họ tên" required />
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input type="tel" id="consultPhone" name="PhoneNumber" class="form-control" placeholder="0xxx xxx xxx" required pattern="[0-9]{10}" title="Vui lòng nhập số điện thoại 10 chữ số" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email (nếu có)</label>
                        <input type="email" id="consultEmail" name="Email" class="form-control" placeholder="example@email.com" />
                    </div>
                    <div class="form-group" style="margin-top: 20px;">
                        <label>Nội dung cần tư vấn</label>
                        <textarea id="consultNote" name="Note" class="form-control" rows="4" placeholder="Nhập nội dung yêu cầu (ví dụ: muốn đăng ký lớp mầm cho bé 3 tuổi)..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary" style="margin-top: 30px; width: 200px; padding: 12px; min-height: 50px;">GỬI YÊU CẦU</button>
                </form>
                <div id="consultResult" style="margin-top: 20px; display: none;"></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('consultForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = this.querySelector('button[type="submit"]');
            const resultDiv = document.getElementById('consultResult');
            const originalText = btn.innerText;
            
            // Basic validation
            const name = document.getElementById('consultName').value.trim();
            const phone = document.getElementById('consultPhone').value.trim();
            
            if (name.length < 2) {
                showResult('Vui lòng nhập họ tên hợp lệ', 'danger');
                return;
            }
            
            if (!/^[0-9]{10}$/.test(phone)) {
                showResult('Số điện thoại phải có 10 chữ số', 'danger');
                return;
            }

            try {
                btn.disabled = true;
                btn.innerText = 'ĐANG GỬI...';
                
                const formData = new FormData(this);
                const response = await fetch('/LandingPage/SubmitConsultation', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showResult('Cảm ơn bạn! Yêu cầu đã được gửi thành công. Chúng tôi sẽ liên hệ lại sớm nhất.', 'success');
                    this.reset();
                } else {
                    showResult(result.message || 'Có lỗi xảy ra. Vui lòng thử lại sau.', 'danger');
                }
            } catch (error) {
                showResult('Không thể kết nối tới máy chủ. Vui lòng kiểm tra mạng.', 'danger');
            } finally {
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });
        
        function showResult(message, type) {
            const resultDiv = document.getElementById('consultResult');
            resultDiv.style.display = 'block';
            resultDiv.className = `alert alert-${type}`;
            resultDiv.style.padding = '15px';
            resultDiv.style.borderRadius = '8px';
            resultDiv.style.marginTop = '20px';
            resultDiv.style.backgroundColor = type === 'success' ? '#dcfce7' : '#fef2f2';
            resultDiv.style.color = type === 'success' ? '#166534' : '#991b1b';
            resultDiv.style.border = `1px solid ${type === 'success' ? '#bbf7d0' : '#fee2e2'}`;
            resultDiv.innerText = message;
            
            if (type === 'success') {
                setTimeout(() => {
                    resultDiv.style.display = 'none';
                }, 10000);
            }
        }
    </script>
}
