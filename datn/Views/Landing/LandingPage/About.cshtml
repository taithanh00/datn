@{
    Layout = "~/Views/Common/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "Giới thiệu về Sen Hồng";
}

<!-- Hero About Section -->
<section class="p-10" style="background: linear-gradient(135deg, #fff5f8 0%, #fdf2f8 100%); padding-top: 160px; padding-bottom: 80px;">
    <div class="container text-center">
        <h1 class="hero-title" style="font-size: 3.5rem; margin-bottom: 24px;">Câu chuyện về <span>Sen Hồng</span></h1>
        <p class="section-subtitle">Hơn cả một ngôi trường, Sen Hồng là tổ ấm thứ hai - nơi mỗi mầm xanh được tưới tẩm bằng tình yêu thương và sự tôn trọng.</p>
    </div>
</section>

<!-- Vision & Mission -->
<section class="p-10">
    <div class="container flex items-center gap-4" style="flex-wrap: wrap;">
        <div style="flex: 1; min-width: 300px;">
            <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                 alt="Tầm nhìn" style="width: 100%; border-radius: 32px; box-shadow: 0 20px 40px rgba(233, 30, 99, 0.1);" />
        </div>
        <div style="flex: 1; min-width: 300px; padding: 40px;">
            <h2 class="section-title" style="font-size: 2.2rem; text-align: left;">Sứ mệnh của chúng tôi</h2>
            <p class="text-secondary mb-4">Sen Hồng ra đời với khát vọng kiến tạo một môi trường giáo dục mà ở đó, trẻ em được là chính mình, được tự do khám phá và phát triển theo nhịp điệu riêng của bản thân.</p>
            <div style="display: grid; gap: 20px;">
                <div class="flex gap-4 items-center">
                    <div style="width: 40px; height: 40px; background: var(--primary-light); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <p style="font-weight: 600;">Giáo dục bằng tình yêu thương và sự kiên nhẫn.</p>
                </div>
                <div class="flex gap-4 items-center">
                    <div style="width: 40px; height: 40px; background: var(--primary-light); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <p style="font-weight: 600;">Khơi dậy tiềm năng sáng tạo vô hạn trong mỗi trẻ.</p>
                </div>
                <div class="flex gap-4 items-center">
                    <div style="width: 40px; height: 40px; background: var(--primary-light); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <p style="font-weight: 600;">Trang bị kỹ năng sống và nền tảng đạo đức vững chắc.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="p-10" style="background: var(--bg-white);">
    <div class="container text-center">
        <h2 class="section-title">Giá trị cốt lõi</h2>
        <p class="section-subtitle">Tại Sen Hồng, chúng tôi tin rằng những giá trị này là "la bàn" dẫn lối cho mọi hoạt động giáo dục.</p>
        
        <div class="grid grid-3">
            <div class="program-card" style="padding: 30px;">
                <div class="card-icon" style="background: #eef2ff; color: #6366f1;"><i class="fa-solid fa-shield-heart"></i></div>
                <h3 class="mb-2">An toàn & Yêu thương</h3>
                <p class="text-muted">Môi trường an toàn tuyệt đối về thể chất và tinh thần để trẻ luôn cảm thấy hạnh phúc.</p>
            </div>
            <div class="program-card" style="padding: 30px;">
                <div class="card-icon" style="background: #ecfdf5; color: #10b981;"><i class="fa-solid fa-lightbulb"></i></div>
                <h3 class="mb-2">Sáng tạo & Đam mê</h3>
                <p class="text-muted">Khuyến khích trẻ đặt câu hỏi, trải nghiệm thực tế và tự do thể hiện bản thân.</p>
            </div>
            <div class="program-card" style="padding: 30px;">
                <div class="card-icon" style="background: #fff7ed; color: #f97316;"><i class="fa-solid fa-hand-holding-heart"></i></div>
                <h3 class="mb-2">Tận tâm & Trách nhiệm</h3>
                <p class="text-muted">Đội ngũ giáo viên luôn coi học sinh như con ruột, chu đáo trong từng bữa ăn giấc ngủ.</p>
            </div>
        </div>
    </div>
</section>

<!-- Message from Principal -->
<section class="p-10" style="background: #fff5f8;">
    <div class="container">
        <div class="card" style="padding: 60px; border-radius: 40px; border: none; display: flex; align-items: center; gap: 40px; flex-wrap: wrap;">
            <div style="flex: 1; text-align: center;">
                <div style="position: relative; display: inline-block;">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                         alt="Hiệu trưởng" style="width: 250px; height: 250px; object-fit: cover; border-radius: 50%; border: 8px solid white; box-shadow: 0 15px 30px rgba(0,0,0,0.1);" />
                    <div style="position: absolute; bottom: 10px; right: 10px; width: 60px; height: 60px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; border: 4px solid white;">
                        <i class="fa-solid fa-quote-right"></i>
                    </div>
                </div>
                <h4 style="margin-top: 20px; font-size: 1.25rem; font-weight: 700;">Cô Nguyễn Minh Phương</h4>
                <p class="text-muted">Hiệu trưởng trường Mầm non Sen Hồng</p>
            </div>
            <div style="flex: 2; min-width: 300px;">
                <h3 class="mb-4" style="color: var(--primary); font-weight: 800; font-size: 1.8rem;">Lời ngỏ từ Ban giám hiệu</h3>
                <p style="font-style: italic; font-size: 1.1rem; color: var(--text-secondary); line-height: 1.8;">
                    "Tại Sen Hồng, chúng tôi không chỉ dạy chữ, dạy số. Chúng tôi dạy các em cách cảm nhận hạnh phúc từ những điều nhỏ nhất, dạy các em biết yêu thương bản thân và thế giới xung quanh. 
                    Mỗi ngày đến trường với trẻ là một hành trình khám phá đầy ắp tiếng cười. Chúng tôi hiểu rằng, niềm tin của quý phụ huynh là món quà vô giá nhất, và chúng tôi luôn nỗ lực mỗi ngày để xứng đáng với niềm tin đó."
                </p>
            </div>
        </div>
    </div>
</section>
