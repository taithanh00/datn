@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SenHồng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/pages/login.css")" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <div class="container">
        <div class="login-card">
            <div class="left-panel" style="background: linear-gradient(135deg, #fb923c 0%, #f97316 100%); display: flex; align-items: center; justify-content: center; color: white; text-align: center; padding: 20px;">
                <div>
                    <i class="fa-solid fa-shield-keyhole" style="font-size: 5rem; margin-bottom: 20px; opacity: 0.8;"></i>
                    <h2 style="font-weight: 800; margin-bottom: 10px;">Khôi phục quyền truy cập</h2>
                    <p style="opacity: 0.9; font-size: 0.9rem;">Đừng lo lắng, chúng tôi sẽ giúp bạn lấy lại mật khẩu thông qua Email đăng ký.</p>
                </div>
            </div>

            <div class="right-panel">
                <h2 class="form-title">Quên mật khẩu?</h2>
                <p class="text-muted" style="margin-bottom: 24px; font-size: 0.9rem; color: #666;">
                    Nhập địa chỉ Email đã đăng ký với tài khoản của bạn để nhận hướng dẫn khôi phục.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-xmark"></i> @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success" style="background: #ecfdf5; border-color: #10b981; color: #065f46; border-left: 4px solid #10b981; border-radius: 12px; padding: 12px 16px; font-size: 13px; margin-bottom: 18px;">
                        <i class="fa-solid fa-circle-check"></i> @ViewBag.Success
                    </div>
                }

                <form method="post" action="/Auth/ForgotPassword">
                    @Html.AntiForgeryToken()
                    <div class="field-group">
                        <label for="email">Email đăng ký</label>
                        <input type="email" id="email" name="email" placeholder="email@vi-du.com" required />
                    </div>

                    <button type="submit" class="btn-login" style="margin-top: 10px;">Gửi yêu cầu khôi phục</button>
                </form>

                <div class="divider">hoặc</div>

                <a href="/Auth/Login" style="text-align: center; color: #666; text-decoration: none; font-size: 14px; font-weight: 600; display: block; padding: 10px;">
                    <i class="fa-solid fa-arrow-left" style="margin-right: 5px;"></i> Quay lại Đăng nhập
                </a>
            </div>
        </div>
    </div>
</body>
</html>
