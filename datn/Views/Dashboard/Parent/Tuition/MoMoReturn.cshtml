@{
    ViewData["Title"] = "Kết quả thanh toán";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Kết quả thanh toán</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Hệ thống phản hồi từ cổng thanh toán MoMo</p>
    </div>
</div>

<div class="card p-5 text-center" style="max-width: 600px; margin: 0 auto;">
    @if (ViewBag.Type == "success")
    {
        <div style="font-size: 4rem; color: var(--success); margin-bottom: 16px;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h2 style="color: var(--success); margin-bottom: 16px;">Thanh toán thành công!</h2>
        <p class="text-muted mb-4">@ViewBag.Message</p>
        
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info me-2"></i> Hệ thống đã cập nhật trạng thái học phí. Vui lòng kiểm tra lại trong danh sách.
        </div>
    }
    else
    {
        <div style="font-size: 4rem; color: var(--danger); margin-bottom: 16px;">
            <i class="fa-solid fa-circle-xmark"></i>
        </div>
        <h2 style="color: var(--danger); margin-bottom: 16px;">Thanh toán thất bại</h2>
        <p class="text-muted mb-4">@ViewBag.Message</p>
        
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> Giao dịch không thành công hoặc đã bị hủy. Nếu tài khoản của bạn đã bị trừ tiền, vui lòng liên hệ nhà trường để được hỗ trợ.
        </div>
    }

    <div class="mt-4">
        <a href="/Parent/Tuition/MyTuition" class="btn btn-primary"><i class="fa-solid fa-arrow-left me-2"></i> Trở về trang Học phí</a>
    </div>
</div>
