@model datn.Models.Holiday
@{
    ViewData["Title"] = "Chi tiết ngày lễ";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chi tiết ngày lễ</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Thông tin ngày nghỉ chung của trường.</p>
    </div>
</div>

<div class="card" style="max-width:760px;">
    <div class="d-flex align-center gap-2 mb-3">
        <span class="badge badge-info"><i class="fa-solid fa-umbrella-beach"></i> Ngày lễ</span>
        <span class="badge badge-success">@ViewBag.StatusText</span>
    </div>

    <h3 style="margin:0 0 20px;">@Model.Name</h3>

    <div style="margin-bottom:20px;">
        <div class="text-muted" style="font-size:0.8rem; margin-bottom:6px;">Ngày nghỉ</div>
        <div style="font-weight:700;">@Model.Date.ToString("dd/MM/yyyy")</div>
    </div>

    <div>
        <div class="text-muted" style="font-size:0.8rem; margin-bottom:6px;">Ghi chú</div>
        <div>@(string.IsNullOrWhiteSpace(Model.Description) ? "Không có ghi chú." : Model.Description)</div>
    </div>
</div>
