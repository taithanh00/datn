@model dynamic
@{
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Nhật ký của bé";
}

<link rel="stylesheet" href="~/css/pages/parent-daily.css" asp-append-version="true" />

<div class="container page-content fade-in">
    <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 daily-hero">
        <div class="mb-3 mb-md-0">
            <h2 class="page-title fw-bold">Nhật ký của bé</h2>
            <p class="text-muted mb-0">Hành trình mỗi ngày của con tại trường</p>
        </div>
        <div class="header-actions d-flex gap-2">
            @if (ViewBag.Children != null)
            {
                <select id="studentIdData" class="form-select shadow-sm daily-control">
                    @foreach (var child in ViewBag.Children)
                    {
                        bool isSelected = child.Id == ViewBag.DefaultStudentId;
                        <option value="@child.Id" selected="@isSelected">@child.LastName @child.FirstName</option>
                    }
                </select>
            }
            <input type="date" id="logDate" class="form-control shadow-sm daily-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card p-4 mb-4 daily-card">
                <h5 class="section-title mb-4 fw-bold">Dòng thời gian hôm nay</h5>
                <div class="timeline" id="dailyTimeline"></div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4 mb-4 daily-card">
                <h5 class="section-title mb-4 fw-bold">Sức khỏe & Phát triển</h5>
                <div class="health-overview mb-4" id="healthOverview"></div>
                <div id="growthChart" class="growth-chart"></div>
            </div>

            <div class="card p-4 daily-card">
                <h5 class="section-title mb-4 fw-bold">Khoảnh khắc trong ngày</h5>
                <div class="row g-2" id="photoGallery">
                    <div class="daily-empty compact">
                        <div class="daily-empty-icon">
                            <i class="fa-solid fa-camera-retro"></i>
                        </div>
                        <div>
                            <h4>Chưa có ảnh hôm nay</h4>
                            <p>Giáo viên chưa tải khoảnh khắc nào trong ngày đã chọn.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/pages/parent-daily.js" asp-append-version="true"></script>
}
