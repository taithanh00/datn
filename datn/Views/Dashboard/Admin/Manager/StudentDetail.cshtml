@model datn.Models.Student
@{
    Layout = "_DashboardLayout";
    var backUrl = ViewBag.BackUrl as string ?? "/Manager/Students";
    var backText = ViewBag.BackText as string ?? "Quay lại danh sách";
}

<div class="page-header">
    <div class="header-left">
        <div class="header-icon">
            <i class="fa-solid fa-user-graduate"></i>
        </div>
        <div>
            <h2 class="page-title">Hồ sơ học sinh</h2>
            <p class="page-subtitle">Quản lý thông tin chi tiết của học sinh</p>
        </div>
    </div>
    <div class="header-actions">
        <a href="@backUrl" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> @backText
        </a>
    </div>
</div>

<div class="student-profile-grid">
    <!-- Left Column: Avatar & Basic Stats -->
    <div class="profile-sidebar">
        <div class="card profile-card">
            <div class="avatar-wrapper">
                <img src="@(Model.AvatarPath ?? "/images/lion_orange.png")" alt="Avatar" />
                <div class="status-indicator active"></div>
            </div>
            <h3 class="student-name">@Model.FullName</h3>
            <span class="student-code">ID: @Model.Id</span>
            
            <div class="quick-stats">
                <div class="stat-item">
                    <span class="stat-label" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">Lớp</span>
                    <span class="stat-value">@(Model.Class?.Name ?? "N/A")</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">Giới tính</span>
                    <span class="stat-value">@(Model.Gender ? "Nam" : "Nữ")</span>
                </div>
            </div>
        </div>

        <div class="card info-card mt-4">
            <h4>Thông tin liên hệ</h4>
            <div class="info-list">
                <div class="info-item">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <label>Địa chỉ</label>
                        <p>@(Model.Address ?? "Chưa cập nhật")</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fa-solid fa-calendar-day"></i>
                    <div>
                        <label>Ngày nhập học</label>
                        <p>@(Model.EnrollDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Detailed Info & Tabs -->
    <div class="profile-main">
        <div class="card main-card">
            <div class="card-header-tabs">
                <button class="tab-btn active" data-tab="basic">Thông tin cá nhân</button>
                <button class="tab-btn" data-tab="parents">Phụ huynh</button>
                <button class="tab-btn" data-tab="history">Lịch sử học tập</button>
            </div>
            
            <div class="tab-content active" id="basic">
                <div class="detail-grid">
                    <div class="detail-group">
                        <label>Họ</label>
                        <p>@Model.LastName</p>
                    </div>
                    <div class="detail-group">
                        <label>Tên</label>
                        <p>@Model.FirstName</p>
                    </div>
                    <div class="detail-group">
                        <label>Ngày sinh</label>
                        <p>@Model.DateOfBirth.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="detail-group">
                        <label>Giới tính</label>
                        <p>@(Model.Gender ? "Nam" : "Nữ")</p>
                    </div>

                    @{
                        var father = Model.ParentStudents?
                            .FirstOrDefault(ps => ps.Relationship == "Bố" || ps.Relationship == "Bá»‘")?.Parent;
                        var mother = Model.ParentStudents?
                            .FirstOrDefault(ps => ps.Relationship == "Mẹ" || ps.Relationship == "Máº¹")?.Parent;
                    }

                    @if (father != null)
                    {
                        <div class="detail-group">
                            <label>Họ tên bố</label>
                            <p>@($"{father.LastName} {father.FirstName}")</p>
                        </div>
                    }

                    @if (mother != null)
                    {
                        <div class="detail-group">
                            <label>Họ tên mẹ</label>
                            <p>@($"{mother.LastName} {mother.FirstName}")</p>
                        </div>
                    }

                    <div class="detail-group full-width">
                        <label>Ghi chú</label>
                        <p class="text-muted">Chưa có ghi chú nào cho học sinh này.</p>
                    </div>
                </div>
            </div>

            <div class="tab-content" id="parents">
    @if (Model.ParentStudents == null || !Model.ParentStudents.Any())
    {
        <div class="empty-state">
            <i class="fa-solid fa-users"></i>
            <p>Chưa có phụ huynh được liên kết</p>
        </div>
    }
    else
    {
        <div class="detail-grid">
            @foreach (var link in Model.ParentStudents)
            {
                <div class="detail-group">
                    <label>@(string.IsNullOrWhiteSpace(link.Relationship) ? "Phụ huynh" : link.Relationship)</label>
                    <p>@($"{link.Parent.LastName} {link.Parent.FirstName}".Trim())</p>
                </div>
            }
        </div>
    }
</div>
<div class="tab-content" id="history">
                <div class="empty-state">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <p>Chưa có dữ liệu lịch sử học tập</p>
                </div>
            </div>

            <div class="tab-content" id="finance">
                <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h4 style="margin:0;">Cấu hình các khoản thu riêng cho học sinh</h4>
                    <button class="btn btn-primary btn-sm" onclick="showAddFeeConfigModal()">
                        <i class="fa-solid fa-plus"></i> Đăng ký khoản thu
                    </button>
                </div>
                
                <div class="table-container">
                    <table id="studentFinanceTable">
                        <thead>
                            <tr>
                                <th>Khoản thu</th>
                                <th>Số tiền (VNĐ)</th>
                                <th>Giảm trừ</th>
                                <th>Thành tiền</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="studentFinanceBody">
                            <tr><td colspan="5" class="text-center">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal đăng ký khoản thu cho học sinh -->
<div class="modal-overlay" id="financeModalOverlay">
    <div class="modal-card" style="width: 500px; max-width: 95vw;">
        <div class="modal-header">
            <div class="modal-title" id="financeModalTitle">Đăng ký khoản thu</div>
            <button class="modal-close" onclick="closeFinanceModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div>
            <form id="studentFeeForm">
                <input type="hidden" id="studentIdHidden" value="@Model.Id" />
                <input type="hidden" id="configId" />
                
                <div class="form-group" id="feeItemSelectGroup">
                    <label class="form-label">Chọn khoản thu <span class="text-danger">*</span></label>
                    <select id="feeItemIdSelect" class="form-select" required onchange="onFeeItemChanged()">
                        <option value="">-- Chọn khoản thu --</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Số tiền (VNĐ) <span class="text-muted">(Để trống nếu dùng giá mặc định)</span></label>
                    <input type="number" id="configAmount" class="form-input" placeholder="VD: 500000">
                </div>
                
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">Giảm trừ (Số tiền)</label>
                        <input type="number" id="configDiscountAmount" class="form-input" value="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giảm trừ (%)</label>
                        <input type="number" id="configDiscountPercentage" class="form-input" value="0" min="0" max="100">
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Ghi chú</label>
                    <textarea id="configNote" class="form-input" rows="2"></textarea>
                </div>
            </form>
        </div>
        <div class="d-flex justify-end mt-4 gap-2">
            <button type="button" class="btn btn-outline" onclick="closeFinanceModal()">Hủy</button>
            <button type="button" class="btn btn-primary" onclick="saveStudentFeeConfig()">Lưu cấu hình</button>
        </div>
    </div>
</div>

<script src="~/js/pages/student-finance.js" asp-append-version="true"></script>

<style>
    .student-profile-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 24px;
        margin-top: 24px;
    }

    .profile-card {
        text-align: center;
        padding: 40px 24px;
    }

    .avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
    }

    .avatar-wrapper img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--bg-main);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .status-indicator {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 3px solid white;
    }

    .status-indicator.active { background: #10b981; }

    .student-name {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .student-code {
        display: inline-block;
        background: var(--primary-soft);
        color: var(--primary);
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 24px;
    }

    .quick-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid var(--border);
        padding-top: 20px;
    }

    .stat-item .stat-label {
        display: block;
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .stat-item .stat-value {
        font-weight: 600;
        color: var(--text-main);
    }

    .info-card h4 {
        margin-bottom: 20px;
        font-size: 1rem;
    }

    .info-item {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
    }

    .info-item i {
        color: var(--primary);
        font-size: 1.1rem;
        margin-top: 4px;
    }

    .info-item label {
        display: block;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 2px;
    }

    .info-item p {
        margin: 0;
        font-weight: 500;
    }

    /* Main Card Styling */
    .card-header-tabs {
        display: flex;
        gap: 32px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 30px;
        padding: 0 24px;
    }

    .tab-btn {
        background: none;
        border: none;
        padding: 16px 0;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }

    .tab-btn.active {
        color: var(--primary);
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--primary);
    }

    .tab-content {
        display: none;
        padding: 0 24px 30px;
    }

    .tab-content.active {
        display: block;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .detail-group label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .detail-group p {
        background: var(--bg-main);
        padding: 12px 16px;
        border-radius: 8px;
        font-weight: 500;
        margin: 0;
    }

    .detail-group.full-width {
        grid-column: span 2;
    }

    .empty-state {
        text-align: center;
        padding: 60px 0;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.3;
    }
</style>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            
            btn.classList.add('active');
            document.getElementById(btn.dataset.tab).classList.add('active');
        });
    });
</script>
