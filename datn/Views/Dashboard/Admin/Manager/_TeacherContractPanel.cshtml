<div class="modal-overlay" id="contractModalOverlay"></div>

<aside class="slide-panel" id="contractSlidePanel" aria-hidden="true">
    <div class="slide-panel-header">
        <h3 id="contractPanelTitle">Thêm hợp đồng</h3>
        <button type="button" class="close-btn" id="closeContractPanelBtn" aria-label="Đóng">
            <i class="fa-solid fa-xmark" style="font-size:1.2rem;"></i>
        </button>
    </div>

    <div class="slide-panel-body">
        <div class="contract-alert" id="contractFormAlert"></div>
        <form id="contractForm" enctype="multipart/form-data">
            <input type="hidden" id="contractId" />

            <div class="form-section">
                <h4>Thông tin hợp đồng</h4>
                <div class="form-group" id="contractEmployeeGroup">
                    <label class="form-label" for="contractEmployeeId">Giáo viên <span class="text-danger">*</span></label>
                    <select id="contractEmployeeId" class="form-select" required>
                        <option value="">-- Chọn giáo viên --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="contractNumber">Số hợp đồng <span class="text-danger">*</span></label>
                    <input type="text" id="contractNumber" class="form-input" maxlength="100" placeholder="Ví dụ: HĐGV-2026-001" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="contractType">Loại hợp đồng <span class="text-danger">*</span></label>
                    <input type="text" id="contractType" class="form-input" maxlength="100" placeholder="Ví dụ: Xác định thời hạn" required />
                </div>
            </div>

            <div class="form-section">
                <h4>Thời hạn & lương</h4>
                <div class="form-group">
                    <label class="form-label" for="signedDate">Ngày ký <span class="text-danger">*</span></label>
                    <input type="date" id="signedDate" class="form-input" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="effectiveDate">Ngày hiệu lực <span class="text-danger">*</span></label>
                    <input type="date" id="effectiveDate" class="form-input" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="expiryDate">Ngày hết hạn</label>
                    <input type="date" id="expiryDate" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="agreedSalary">Lương thỏa thuận</label>
                    <input type="number" id="agreedSalary" class="form-input" min="0" step="1000" placeholder="Ví dụ: 8000000" />
                </div>
            </div>

            <div class="form-section">
                <h4>Thông tin làm việc</h4>
                <div class="form-group">
                    <label class="form-label" for="workPosition">Vị trí</label>
                    <input type="text" id="workPosition" class="form-input" maxlength="200" placeholder="Ví dụ: Giáo viên mầm non" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="workLocation">Địa điểm làm việc</label>
                    <input type="text" id="workLocation" class="form-input" maxlength="200" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="workingHours">Thời gian làm việc</label>
                    <input type="text" id="workingHours" class="form-input" maxlength="200" placeholder="Ví dụ: Thứ 2 - Thứ 6, 7:30 - 16:30" />
                </div>
            </div>

            <div class="form-section">
                <h4>Tệp đính kèm</h4>
                <div class="form-group">
                    <label class="form-label" for="contractStatus">Trạng thái khi lưu</label>
                    <select id="contractStatus" class="form-select">
                        <option value="Draft">Bản nháp</option>
                        <option value="Active">Đang hiệu lực</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="contractFile">File hợp đồng</label>
                    <input type="file" id="contractFile" class="form-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    <p class="text-muted contract-file-hint">Hỗ trợ PDF, DOC, DOCX, JPG, PNG. Tối đa 10MB.</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="contractNote">Ghi chú</label>
                    <textarea id="contractNote" class="form-input" rows="4"></textarea>
                </div>
            </div>

            <div class="form-actions contract-form-actions">
                <button type="button" class="btn btn-outline" id="cancelContractFormBtn">Hủy</button>
                <button type="submit" class="btn btn-primary" id="saveContractBtn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu hợp đồng
                </button>
            </div>
        </form>
    </div>
</aside>
