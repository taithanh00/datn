@{
    ViewData["Title"] = "Kế hoạch giảng dạy";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Kế hoạch giảng dạy</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Tạo và quản lý kế hoạch giảng dạy cho các lớp.</p>
    </div>
    <div class="page-actions" style="gap:12px; flex-wrap:wrap;">
        <select class="form-select" id="filterClassId" onchange="loadPlans()" style="width:auto; min-width:180px;">
            <option value="">Tất cả lớp</option>
        </select>
        <div class="search-bar" style="min-width:280px;">
            <i class="fa-solid fa-search"></i>
            <input type="text" id="searchPlan" placeholder="Tìm tên chương trình..." onkeyup="applyFilters()" />
        </div>
        <button class="btn btn-primary" type="button" onclick="prepareCreate(); openPlanPanel();">
            <i class="fa-solid fa-plus"></i> Thêm kế hoạch
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-center justify-between" style="gap:12px; flex-wrap:wrap;">
        <h3 class="card-title">Danh sách kế hoạch</h3>
        <div class="status-tabs" style="margin-bottom:0;">
            <div class="status-tab active" data-show-inactive="false">
                <i class="fa-solid fa-list-check"></i> Đang thực hiện
            </div>
            <div class="status-tab" data-show-inactive="true">
                <i class="fa-solid fa-box-archive"></i> Lưu trữ
            </div>
        </div>
    </div>
    <div class="table-container">
        <table id="plansTable">
            <thead><tr><th>Lớp</th><th>Chương trình</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="planPanelOverlay"></div>
<div class="slide-panel" id="planSlidePanel">
    <div class="slide-panel-header">
        <div>
            <h3 id="planPanelTitle">Thêm kế hoạch mới</h3>
            <p class="text-muted" style="font-size:0.9rem; margin:4px 0 0;">Nhập thông tin để tạo kế hoạch giảng dạy.</p>
        </div>
        <button class="close-btn" type="button" onclick="closePlanPanel()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="slide-panel-body">
        <div id="planPanelAlert" class="page-alert" style="display:none;"></div>
        <form id="planForm" class="mb-0">
            <input type="hidden" id="isEdit" value="false" />
            <div class="form-group"><label class="form-label">Lớp học <span class="text-danger">*</span></label><select id="classId" class="form-select" required></select></div>
            <div class="form-group"><label class="form-label">Chương trình học <span class="text-danger">*</span></label><select id="curriculumId" class="form-select" required></select></div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:16px;">
                <div class="form-group"><label class="form-label">Bắt đầu <span class="text-danger">*</span></label><input id="startDate" type="date" class="form-input" required /></div>
                <div class="form-group"><label class="form-label">Kết thúc</label><input id="endDate" type="date" class="form-input" /></div>
            </div>
            <div class="form-group" style="margin-top:16px;"><label class="form-label">Trạng thái</label>
                <select id="status" class="form-select">
                    <option value="Planned">Đã lên lịch</option>
                    <option value="InProgress">Đang thực hiện</option>
                    <option value="Completed">Hoàn thành</option>
                </select>
            </div>
            <div class="d-flex gap-1 mt-3">
                <button type="submit" class="btn btn-primary">Lưu kế hoạch</button>
                <button type="button" class="btn btn-outline" onclick="closePlanPanel()">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/teaching-plans.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/teaching-plans.js" asp-append-version="true"></script>
}
