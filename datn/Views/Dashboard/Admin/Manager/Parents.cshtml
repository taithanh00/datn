@{
    ViewData["Title"] = "Phụ huynh";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <h1 class="page-title">Quản lý Phụ huynh</h1>
    <div class="page-actions">
        <div class="search-bar">
            <i class="fa-solid fa-search"></i>
            <input type="text" id="searchParents" placeholder="Tìm kiếm tên hoặc số điện thoại..." />
        </div>
        <button class="btn-filter-toggle" id="btnToggleFilter">
            <i class="fa-solid fa-filter"></i> Bộ lọc
        </button>
        <button class="btn btn-primary" id="btnCreateParent">
            <i class="fa-solid fa-user-plus"></i> Thêm phụ huynh
        </button>
    </div>
</div>

<div class="filter-panel" id="filterPanel">
    <div class="filter-grid">
        <div class="filter-group">
            <label>Giới tính</label>
            <select id="filterGender" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="true">Nam</option>
                <option value="false">Nữ</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Liên kết con</label>
            <select id="filterHasChildren" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="yes">Đã liên kết</option>
                <option value="no">Chưa liên kết</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" id="btnApplyFilter">Áp dụng</button>
            <button class="btn btn-outline" id="btnResetFilter">Đặt lại</button>
        </div>
    </div>
</div>

<div class="status-tabs">
    <div class="status-tab active" data-show-inactive="false">
        <i class="fa-solid fa-users"></i> Đang hoạt động
    </div>
    <div class="status-tab" data-show-inactive="true">
        <i class="fa-solid fa-user-slash"></i> Đã ngưng/Khóa
    </div>
</div>

<div class="card">
    <div class="table-container">
        <table id="parentsTable">
            <thead>
                <tr>
                    <th class="sticky-col first-col">STT</th>
                    <th class="sticky-col second-col">ID</th>
                    <th class="sticky-col third-col">Ảnh</th>
                    <th class="sticky-col fourth-col">Họ và tên</th>
                    <th>Trạng thái</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Số con</th>
                    <th>Danh sách con</th>
                    <th>Lớp của con</th>
                    <th>Ngày tạo</th>
                    <th>Cập nhật</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody id="parentsTableBody">
                <tr class="loading-row">
                    <td colspan="17" style="text-align:center; padding:40px;">
                        <div class="spinner"></div>
                        <p class="text-muted">Đang tải dữ liệu...</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay"></div>

<!-- Slide-out Panel -->
<div class="slide-panel" id="slidePanel">
    <div class="slide-panel-header">
        <h3 id="panelTitle">Thêm phụ huynh mới</h3>
        <button class="close-btn" id="closePanelBtn">
            <i class="fa-solid fa-xmark" style="font-size:1.2rem;"></i>
        </button>
    </div>
    <div class="slide-panel-body">
        <form id="parentForm" enctype="multipart/form-data">
            <input type="hidden" id="parentId" name="Id" />

            <div class="form-section">
                <h4><i class="fa-solid fa-circle-user"></i> Thông tin tài khoản</h4>
                <div class="form-group" style="text-align:center; margin-bottom:24px;">
                    <div class="avatar-upload-wrapper">
                        <div class="avatar-preview-container" onclick="document.getElementById('avatarInput').click()">
                            <img id="avatarPreview" src="/images/lion_orange.png" alt="Preview" />
                            <div class="avatar-overlay">
                                <i class="fa-solid fa-camera"></i>
                                <span>THAY ĐỔI</span>
                            </div>
                        </div>
                        <input type="file" id="avatarInput" name="Avatar" hidden accept="image/*" onchange="previewImage(this)" />
                        <p class="text-muted small mt-2">Ảnh đại diện phụ huynh</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="username">Tên đăng nhập <span class="text-danger">*</span></label>
                    <input type="text" id="username" name="Username" class="form-control" required placeholder="Ví dụ: ph_nguyenvan" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="email">Email liên hệ <span class="text-danger">*</span></label>
                    <input type="email" id="email" name="Email" class="form-control" required placeholder="Ví dụ: phuhuynh@gmail.com" />
                </div>
                <div class="form-group" id="passwordFieldGroup">
                    <label class="form-label" for="password">Mật khẩu</label>
                    <input type="password" id="password" name="Password" class="form-control" placeholder="Mật khẩu tài khoản" />
                    <div class="requirement-list">
                        <div id="req-length" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 9 ký tự</div>
                        <div id="req-upper" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 1 chữ hoa</div>
                        <div id="req-special" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 1 ký tự đặc biệt</div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h4><i class="fa-solid fa-address-card"></i> Thông tin cá nhân</h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="lastName">Họ <span class="text-danger">*</span></label>
                            <input type="text" id="lastName" name="LastName" class="form-control" required placeholder="Nguyễn" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" for="firstName">Tên <span class="text-danger">*</span></label>
                            <input type="text" id="firstName" name="FirstName" class="form-control" required placeholder="Văn A" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Giới tính</label>
                    <div class="gender-selection">
                        <label class="gender-option">
                            <input type="radio" name="Gender" value="true" checked>
                            <div class="gender-box">Nam</div>
                        </label>
                        <label class="gender-option">
                            <input type="radio" name="Gender" value="false">
                            <div class="gender-box">Nữ</div>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="dateOfBirth">Ngày sinh</label>
                    <input type="date" id="dateOfBirth" name="DateOfBirth" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="phone">Số điện thoại</label>
                    <input type="text" id="phone" name="Phone" class="form-control" placeholder="Số điện thoại liên hệ" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="address">Địa chỉ</label>
                    <textarea id="address" name="Address" class="form-control" rows="2" placeholder="Địa chỉ thường trú"></textarea>
                </div>
            </div>

            <!-- Linked Students Section (create + edit) -->
            <div id="linkedStudentsSection" class="form-section" style="display:none;">
                <h4>
                    <i class="fa-solid fa-users"></i> Danh sách con
                    <button type="button" class="btn-add-child" onclick="openLinkStudentPanel()">
                        <i class="fa-solid fa-plus"></i> Thêm con
                    </button>
                </h4>
                <p class="text-muted small" id="linkedStudentsHint" style="margin: 0 0 12px;">
                    Liên kết học sinh ngay khi tạo phụ huynh (có thể bỏ qua và thêm sau).
                </p>
                <div id="linkedStudentsList" class="linked-students-list">
                    <!-- Linked students will appear here -->
                </div>
            </div>

            <div id="formAlert" class="form-alert" style="display:none;"></div>

            <div class="form-actions">
                <button type="button" class="btn-save" onclick="saveParent()" id="saveParentBtn">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu thông tin
                </button>
                <button type="button" class="btn-delete" id="deleteParentBtn" style="display:none;" onclick="toggleCurrentParentStatus()">
                    <i class="fa-solid fa-lock"></i> Vô hiệu hóa tài khoản
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Link Slide Panel Overlay (nested) -->
<div class="modal-overlay" id="linkPanelOverlay" style="z-index: 1160;" onclick="event.stopPropagation(); closeLinkStudentPanel();"></div>

<!-- Link Slide Panel (nested on top of parent slide panel) -->
<div class="slide-panel slide-panel-nested" id="linkSlidePanel">
    <div class="slide-panel-header">
        <div style="display:flex; align-items:center; gap:12px;">
            <button class="back-btn" id="linkBackBtn" title="Quay lại">
                <i class="fa-solid fa-arrow-left"></i>
            </button>
            <h3 id="linkPanelTitle">Liên kết Học sinh</h3>
        </div>
        <button class="close-btn" id="closeLinkPanelBtn">
            <i class="fa-solid fa-xmark" style="font-size:1.2rem;"></i>
        </button>
    </div>
    <div class="slide-panel-body" style="padding-bottom:0;">
        <div class="form-group">
            <label class="form-label">Tìm học sinh</label>
            <div class="search-bar" style="min-width: 100%; margin-bottom: 12px;">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="studentSearchInput" placeholder="Nhập tên hoặc mã HS...">
            </div>
            <div id="studentSearchResults" class="list-group" style="max-height: 320px; overflow-y: auto; overflow-x: hidden;">
                <!-- Results here -->
            </div>
        </div>
        <div id="linkDetailSection" style="display:none; margin-top: 16px; padding-top: 16px; border-top: 1px dashed var(--border);">
            <div style="background: var(--bg-main); padding: 12px; border-radius: 8px; margin-bottom: 12px;">
                <span id="selectedStudentName" class="fw-bold"></span>
                <span id="selectedStudentId" class="text-muted small"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Mối quan hệ</label>
                <div class="relationship-grid">
                    <label class="rel-card">
                        <input type="radio" name="relationship" value="Bố" checked>
                        <div class="rel-content">
                            <i class="fa-solid fa-user-tie"></i>
                            <span>Bố</span>
                        </div>
                    </label>
                    <label class="rel-card">
                        <input type="radio" name="relationship" value="Mẹ">
                        <div class="rel-content">
                            <i class="fa-solid fa-user-nurse"></i>
                            <span>Mẹ</span>
                        </div>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <!-- Bug 1 fix: dùng CSS thuần thay vì btn-primary/btn-secondary của Bootstrap -->
    <div class="link-panel-footer">
        <button class="link-btn-close" id="linkPanelCloseBtn">Đóng</button>
        <button class="link-btn-confirm" id="linkPanelConfirmBtn" onclick="confirmLinkStudent()" disabled>
            <i class="fa-solid fa-link"></i> Xác nhận liên kết
        </button>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/parents.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/parents.js" asp-append-version="true"></script>
}
