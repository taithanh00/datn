@{
    ViewData["Title"] = "Danh mục môn học";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    @Html.AntiForgeryToken()
    <h1 class="page-title">Quản lý Danh mục môn học</h1>
    <div class="page-actions">
        <button class="btn btn-primary" id="resetSubjectFormBtn" type="button">
            <i class="fa-solid fa-plus"></i> Tạo môn mới
        </button>
    </div>
</div>

<div class="card">
    <div class="d-flex align-center justify-between mb-2">
        <h3>Danh mục môn học</h3>
        <div class="status-tabs" style="margin-bottom:0;">
            <div class="status-tab active" data-show-inactive="false" data-scope="subjects">
                <i class="fa-solid fa-book"></i> Đang sử dụng
            </div>
            <div class="status-tab" data-show-inactive="true" data-scope="subjects">
                <i class="fa-solid fa-box-archive"></i> Đã ngưng
            </div>
        </div>
    </div>
    <div id="subjectAlert" style="display:none; padding:12px; border-radius:8px; margin-bottom:16px; font-size:0.85rem;"></div>
    <div class="table-container">
        <table id="subjectsTable">
            <thead>
                <tr>
                    <th>Mã môn</th>
                    <th>Tên môn</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="subjectsTableBody"></tbody>
        </table>
</div>

<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay"></div>

<!-- Slide-out Panel -->
<div class="slide-panel" id="slidePanel">
    <div class="slide-panel-header">
        <h3 id="panelTitle">Thêm môn học mới</h3>
        <button class="close-btn" id="closePanelBtn" type="button">
            <i class="fa-solid fa-xmark" style="font-size:1.2rem;"></i>
        </button>
    </div>
    <div class="slide-panel-body">
        <form id="subjectForm">
            <input type="hidden" id="subjectId" />
            
            <div class="form-section">
                <h4>Thông tin môn học</h4>
                <div class="form-group">
                    <label class="form-label" for="subjectCode">Mã môn <span class="text-danger">*</span></label>
                    <input id="subjectCode" type="text" class="form-control" required placeholder="Ví dụ: TOAN1" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="subjectName">Tên môn <span class="text-danger">*</span></label>
                    <input id="subjectName" type="text" class="form-control" required placeholder="Nhập tên môn học" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="subjectDescription">Mô tả</label>
                    <textarea id="subjectDescription" class="form-control" rows="3" placeholder="Nhập mô tả môn học"></textarea>
                </div>
                <div class="form-group" style="display:flex; align-items:center; gap:8px;">
                    <input id="subjectIsActive" type="checkbox" checked />
                    <label for="subjectIsActive" style="font-size:0.9rem; user-select:none; cursor:pointer;">Đang sử dụng</label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save" id="saveSubjectBtn">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Lưu môn học
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/classes.js" asp-append-version="true"></script>
}
