@{
    ViewData["Title"] = "Chương trình học";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Chương trình học</h1>
    <div class="page-actions">
        <button class="btn btn-primary" id="resetFormBtn" type="button"><i class="fa-solid fa-plus"></i> Tạo chương trình</button>
    </div>
</div>

<div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; gap:16px; flex-wrap:wrap;">
        <div id="alert" class="page-alert" style="display:none;"></div>
        <div class="status-tabs" style="margin-bottom:0;">
            <div class="status-tab active" data-show-inactive="false">
                <i class="fa-solid fa-book-open"></i> Đang sử dụng
            </div>
            <div class="status-tab" data-show-inactive="true">
                <i class="fa-solid fa-box-archive"></i> Lưu trữ
            </div>
        </div>
    </div>
    <div class="table-container">
        <table id="curriculumsTable">
            <thead><tr><th>Tên chương trình</th><th>Môn học</th><th>Độ tuổi</th><th>Mô tả</th><th>Thao tác</th></tr></thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="curriculumPanelOverlay"></div>
<div class="slide-panel" id="curriculumSlidePanel">
    <div class="slide-panel-header">
        <h3 id="panelTitle">Thêm chương trình mới</h3>
        <button type="button" class="close-btn" onclick="closeCurriculumPanel()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="slide-panel-body">
        <form id="entityForm">
            <input type="hidden" id="entityId" />
            <div class="form-group">
                <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                <input id="title" type="text" class="form-input" required />
            </div>
            <div class="form-group">
                <label class="form-label">Môn học</label>
                <select id="subjectId" class="form-select"></select>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="form-group">
                    <label class="form-label">Tuổi từ</label>
                    <input id="ageFrom" type="number" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label">Tuổi đến</label>
                    <input id="ageTo" type="number" class="form-input" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Mô tả</label>
                <input id="description" type="text" class="form-input" />
            </div>
            <div class="form-group">
                <label class="form-label">Nội dung chi tiết</label>
                <textarea id="content" class="form-input" rows="6"></textarea>
            </div>
            <div class="d-flex gap-1 mt-2">
                <button type="submit" class="btn btn-primary" id="saveBtn">Lưu chương trình</button>
                <button type="button" class="btn btn-outline" id="clearBtn">Làm mới</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/curriculums.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/curriculums.js" asp-append-version="true"></script>
}
