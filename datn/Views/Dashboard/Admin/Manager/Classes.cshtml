@{
    ViewData["Title"] = "Lớp học";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    @Html.AntiForgeryToken()
    <h1 class="page-title">Quản lý Lớp học</h1>
    <div class="page-actions">
        <button class="btn btn-primary" id="resetClassFormBtn" type="button">
            <i class="fa-solid fa-plus"></i> Tạo lớp mới
        </button>
    </div>
</div>

<div class="card">
    <div class="d-flex align-center justify-between mb-2">
        <h3>Danh sách lớp học</h3>
        <div class="status-tabs" style="margin-bottom: 12px;">
            <div class="status-tab active" data-show-inactive="false" data-scope="classes">
                <i class="fa-solid fa-school"></i> Lớp hiện tại
            </div>
            <div class="status-tab" data-show-inactive="true" data-scope="classes">
                <i class="fa-solid fa-box-archive"></i> Lớp đã đóng
            </div>
        </div>
    </div>
    <div id="classAlert" style="display:none; padding:12px; border-radius:8px; margin-bottom:16px; font-size:0.85rem;"></div>
    <div class="table-container">
        <table id="classesTable">
            <thead>
                <tr>
                    <th>Lớp</th>
                    <th>Độ tuổi</th>
                    <th>Niên khóa</th>
                    <th>Sĩ số</th>
                    <th>Giáo viên</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="classesTableBody"></tbody>
        </table>
    </div>
</div>

<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay"></div>

<!-- Slide-out Panel -->
<div class="slide-panel" id="slidePanel">
    <div class="slide-panel-header">
        <h3 id="panelTitle">Thêm lớp học mới</h3>
        <button class="close-btn" id="closePanelBtn" type="button">
            <i class="fa-solid fa-xmark" style="font-size:1.2rem;"></i>
        </button>
    </div>
    <div class="slide-panel-body">
        <div id="classFormAlert" class="form-alert" style="display:none;"></div>
        <form id="classForm">
            <input type="hidden" id="classId" />
            
            <div class="form-section">
                <h4>Thông tin cơ bản</h4>
                <div class="form-group">
                    <label class="form-label" for="className">Tên lớp <span class="text-danger">*</span></label>
                    <input id="className" type="text" class="form-control" required placeholder="Nhập tên lớp" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="schoolYear">Niên khóa <span class="text-danger">*</span></label>
                    <input id="schoolYear" type="text" class="form-control" placeholder="Ví dụ: 2025-2026" pattern="\d{4}-\d{4}" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="ageRange">Độ tuổi <span class="text-danger">*</span></label>
                    <select id="ageRange" class="form-control" required>
                        <option value="">-- Chọn độ tuổi --</option>
                        <option value="2-3">24 - 36 tháng</option>
                        <option value="3-4">3 - 4 tuổi</option>
                        <option value="4-5">4 - 5 tuổi</option>
                        <option value="5-6">5 - 6 tuổi</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="maxCapacity">Sĩ số tối đa</label>
                    <input id="maxCapacity" type="number" min="1" class="form-control" placeholder="Mặc định: 25" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save" id="saveClassBtn">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Lưu lớp học
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/classes.js" asp-append-version="true"></script>
}
