@{
    ViewData["Title"] = "Theo dõi nộp học phí";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
    var currentYear = DateTime.Now.Year;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Theo dõi nộp học phí</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Kiểm tra và xác nhận tình trạng đóng phí của học sinh</p>
    </div>
    <div class="page-actions">
        <div class="search-bar">
            <i class="fa-solid fa-search"></i>
            <input id="tuitionSearch" type="search" placeholder="Tìm học sinh theo tên hoặc ID..." autocomplete="off" />
        </div>
        <button id="btnToggleFilter" type="button" class="btn-filter-toggle">
            <i class="fa-solid fa-filter"></i>
            Bộ lọc
        </button>
        <a href="/Tuition" class="btn btn-outline" style="border-color: var(--border-focus);">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div id="filterPanel" class="filter-panel">
    <div class="filter-grid">
        <div class="filter-group">
            <label>Tháng</label>
            <select id="monMonth" class="form-control">
                @for (int i = 1; i <= 12; i++)
                {
                    var isSelected = DateTime.Now.Month == i;
                    <option value="@i" selected="@isSelected">Tháng @i</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Năm</label>
            <select id="monYear" class="form-control">
                @for (int year = currentYear - 1; year <= currentYear + 1; year++)
                {
                    var isSelected = currentYear == year;
                    <option value="@year" selected="@isSelected">@year</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Lớp học</label>
            <select id="monClass" class="form-control">
                <option value="">-- Tất cả --</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Trạng thái</label>
            <select id="monStatus" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="true">Đã nộp</option>
                <option value="false">Chờ nộp</option>
            </select>
        </div>
        <div class="filter-actions">
            <button id="btnApplyFilter" type="button" class="btn btn-primary">Áp dụng</button>
            <button id="btnResetFilter" type="button" class="btn btn-outline">Đặt lại</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="tuition-table-meta">
        <span id="tuitionResultCount">Đang tải dữ liệu...</span>
    </div>
    <div class="table-container tuition-monitor-table">
        <table id="monitoringTableEl">
            <thead>
                <tr>
                    <th style="padding-left: 24px;">Học sinh</th>
                    <th>Lớp học</th>
                    <th>Học phí + Phụ phí</th>
                    <th style="text-align: center;">Tình trạng</th>
                    <th style="text-align: right; padding-right: 24px;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="monitoringTable">
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2">Đang tải dữ liệu...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/tuition-monitoring.js" asp-append-version="true"></script>
}
