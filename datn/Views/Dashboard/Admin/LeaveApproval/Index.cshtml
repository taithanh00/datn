@{
    ViewData["Title"] = "Duyệt nghỉ phép";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Duyệt chấm công và nghỉ phép</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Quản lý và phê duyệt các yêu cầu từ nhân viên</p>
    </div>
</div>

<style>
    .leave-history-tabs .status-tab {
        border: 0;
        background: transparent;
        font: inherit;
    }

    .leave-history-tabs .status-tab.active {
        background: var(--bg-card);
    }
</style>

<div class="card mb-4">
    <div style="display: flex; gap: 16px; align-items: flex-end;">
        <div class="form-group" style="margin-bottom: 0; min-width: 150px;">
            <label for="filterMonth" class="form-label">Tháng</label>
            <select id="filterMonth" class="form-select"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0; min-width: 150px;">
            <label for="filterYear" class="form-label">Năm</label>
            <select id="filterYear" class="form-select"></select>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
    <div class="card">
        <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: var(--text-main);">
            <div class="avatar" style="background: var(--primary-soft); color: var(--primary); display: inline-flex; width: 32px; height: 32px; font-size: 0.9rem; margin-right: 8px;"><i class="fa-solid fa-clock"></i></div>
            Chấm công chờ duyệt
        </h3>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Ngày</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Trạng thái</th>
                        <th>Phạt</th>
                        <th style="text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="pendingAttendanceBody">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner"></div><p class="mt-2">Đang tải dữ liệu chấm công...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: var(--text-main);">
            <div class="avatar" style="background: rgba(251,191,36,0.15); color: var(--warning); display: inline-flex; width: 32px; height: 32px; font-size: 0.9rem; margin-right: 8px;"><i class="fa-solid fa-calendar-day"></i></div>
            Đơn nghỉ phép chờ duyệt
        </h3>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Thời gian</th>
                        <th>Loại / Lý do</th>
                        <th style="text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="pendingLeaveBody">
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <div class="spinner"></div><p class="mt-2">Đang tải đơn nghỉ phép...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:16px;">
        <h3 style="margin:0; font-size:1.1rem; color:var(--text-main);">
            <div class="avatar" style="background: rgba(59,130,246,0.12); color: #2563eb; display: inline-flex; width: 32px; height: 32px; font-size: 0.9rem; margin-right: 8px;"><i class="fa-solid fa-clock-rotate-left"></i></div>
            Lịch sử duyệt
        </h3>
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
            <div class="status-tabs leave-history-tabs" style="margin-bottom:0;">
                <button type="button" class="status-tab active" data-history-type="attendance">Chấm công</button>
                <button type="button" class="status-tab" data-history-type="leave">Nghỉ phép</button>
            </div>
            <select id="historyStatusFilter" class="form-select" style="width:auto; min-width:140px;">
                <option value="">Tất cả trạng thái</option>
                <option value="Approved">Đã duyệt</option>
                <option value="Rejected">Từ chối</option>
            </select>
            <input id="historyKeyword" type="search" class="form-input" placeholder="Tìm theo tên nhân viên..." style="width:240px;" />
        </div>
    </div>

    <div id="attendanceHistoryPanel">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Ngày</th>
                        <th>Check-in/out</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt</th>
                        <th>Thời gian duyệt</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody id="attendanceHistoryBody">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner"></div><p class="mt-2">Đang tải lịch sử chấm công...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div id="leaveHistoryPanel" style="display:none;">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Thời gian nghỉ</th>
                        <th>Loại / Lý do</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt</th>
                        <th>Thời gian duyệt</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody id="leaveHistoryBody">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner"></div><p class="mt-2">Đang tải lịch sử nghỉ phép...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/pages/leave-approval.js" asp-append-version="true"></script>
}
