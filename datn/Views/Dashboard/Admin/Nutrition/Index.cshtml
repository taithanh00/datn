@{
    ViewData["Title"] = "Quản lý Dinh dưỡng & Thực đơn";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
    var isManager = ViewBag.Role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thực đơn tuần</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">
            Xây dựng mẫu thực đơn chung cho toàn trường, áp dụng lặp lại mỗi tuần.
        </p>
    </div>
</div>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
    <div style="font-size:0.9rem; color:var(--text-muted); font-weight:600;">
        Mẫu tuần: Thứ 2 đến Thứ 7
    </div>
</div>

<div class="card" style="padding:0; overflow:hidden;">
    <div style="overflow-x:auto;">
        <table id="menuGrid" style="width:100%; border-collapse:collapse; min-width:700px;">
            <thead>
                <tr id="gridHeader">
                    <th style="width:110px; padding:12px 16px; text-align:left; background:var(--bg-body); border-bottom:2px solid var(--border); font-size:0.8rem; color:var(--text-muted); text-transform:uppercase;">Bữa ăn</th>
                </tr>
            </thead>
            <tbody id="gridBody"></tbody>
        </table>
    </div>
</div>

<div id="nutritionModalOverlay" class="modal-overlay"></div>
<div class="slide-panel" id="editCard">
    <div class="slide-panel-header">
        <h3 id="editCardTitle">Cập nhật thực đơn</h3>
        <button class="close-btn" onclick="resetForm()" type="button">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="slide-panel-body">
        <form id="menuForm">
            <input type="hidden" id="menuId" value="0" />
            <input type="hidden" id="menuDayOfWeek" />
            <input type="hidden" id="menuType" />

            <div class="form-group">
                <label class="form-label">Tên món ăn <span style="color:var(--danger);">*</span></label>
                <input type="text" id="dishName" class="form-input" required />
            </div>
            <div class="form-group">
                <label class="form-label">Ghi chú</label>
                <textarea id="menuNote" class="form-input" rows="2"></textarea>
            </div>

            @if (isManager)
            {
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="btn btn-primary">Lưu thực đơn</button>
                    <button type="button" class="btn btn-outline" id="deleteBtn" onclick="deleteMenu()" style="display:none; color:var(--danger); border-color:var(--danger);">Xóa món</button>
                </div>
            }
            else
            {
                <div class="alert-info-soft"><i class="fa-solid fa-info-circle"></i> Bạn đang xem ở chế độ chỉ đọc.</div>
            }
        </form>
    </div>
</div>

@section Styles {
<style>
    .meal-row-label {
        padding: 14px 16px;
        background: var(--bg-body);
        border-bottom: 1px solid var(--border);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .menu-cell {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        border-left: 1px solid var(--border);
        height: 72px;
        cursor: pointer;
        transition: background 0.2s;
        position: relative;
        vertical-align: top;
    }

    .menu-cell:hover { background: var(--primary-soft); }
    .menu-cell.empty {
        color: var(--text-muted);
        text-align: center;
        vertical-align: middle;
        font-size: 1.2rem;
    }

    .menu-cell.has-data .dish-name {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--text-main);
        margin-bottom: 4px;
    }

    .menu-cell.has-data .menu-note {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .day-header-cell {
        padding: 12px 10px;
        text-align: center;
        background: var(--bg-body);
        border-bottom: 2px solid var(--border);
        border-left: 1px solid var(--border);
        font-weight: 700;
        color: var(--primary);
    }

    .alert-info-soft {
        padding: 12px;
        background: var(--primary-soft);
        border-radius: 6px;
        color: var(--primary);
        font-size: 0.85rem;
    }

    #menuForm input:disabled,
    #menuForm textarea:disabled {
        background: var(--bg-body);
        color: var(--text-muted);
        cursor: not-allowed;
        opacity: 1;
    }
</style>
}

@section Scripts {
<script>
    const DAYS = [
        { value: 1, label: 'Thứ 2' },
        { value: 2, label: 'Thứ 3' },
        { value: 3, label: 'Thứ 4' },
        { value: 4, label: 'Thứ 5' },
        { value: 5, label: 'Thứ 6' },
        { value: 6, label: 'Thứ 7' }
    ];
    const MEALS = [
        { type: 0, label: 'Sáng' },
        { type: 1, label: 'Trưa' },
        { type: 2, label: 'Xế' }
    ];
    const IS_MANAGER = @(isManager.ToString().ToLower());
    let weeklyMenuData = [];

    document.addEventListener('DOMContentLoaded', () => {
        buildGridHeader();
        loadWeeklyMenu();
        document.getElementById('menuForm').addEventListener('submit', saveMenu);
        document.getElementById('nutritionModalOverlay').addEventListener('click', resetForm);
    });

    function buildGridHeader() {
        const header = document.getElementById('gridHeader');
        DAYS.forEach(day => {
            const th = document.createElement('th');
            th.className = 'day-header-cell';
            th.textContent = day.label;
            header.appendChild(th);
        });
    }

    async function loadWeeklyMenu() {
        try {
            const resp = await fetch('/Manager/Nutrition/GetWeeklyMenu');
            weeklyMenuData = await resp.json();
            renderGrid();
        } catch (e) {
            window.showToast?.('Lỗi', 'Không thể tải thực đơn tuần', 'error');
        }
    }

    function renderGrid() {
        const body = document.getElementById('gridBody');
        body.innerHTML = '';

        MEALS.forEach(meal => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td class="meal-row-label">${meal.label}</td>`;

            DAYS.forEach(day => {
                const item = weeklyMenuData.find(m => m.dayOfWeek === day.value && m.mealType === meal.type);
                const td = document.createElement('td');
                td.className = item ? 'menu-cell has-data' : 'menu-cell empty';

                if (item) {
                    td.innerHTML = `
                        <div class="dish-name">${escapeHtml(item.dishName)}</div>
                        <div class="menu-note">${escapeHtml(item.note || '')}</div>
                    `;
                } else {
                    td.textContent = IS_MANAGER ? '+' : '-';
                }

                if (IS_MANAGER || item) {
                    td.onclick = () => openWeeklyEditor(day.value, meal.type, item);
                }

                tr.appendChild(td);
            });

            body.appendChild(tr);
        });
    }

    function setEditorDisabled(isDisabled) {
        document.querySelectorAll('#menuForm input:not([type="hidden"]), #menuForm textarea')
            .forEach(input => {
                input.disabled = isDisabled;
                input.setAttribute('aria-disabled', isDisabled.toString());
            });
    }

    function openWeeklyEditor(dayOfWeek, mealType, item) {
        const day = DAYS.find(d => d.value === dayOfWeek);
        const meal = MEALS.find(m => m.type === mealType);

        document.getElementById('nutritionModalOverlay').classList.add('active');
        document.getElementById('editCard').classList.add('active');
        document.body.style.overflow = 'hidden';
        document.getElementById('editCardTitle').textContent = `${meal.label} - ${day.label}`;
        document.getElementById('menuId').value = item ? item.id : 0;
        document.getElementById('menuDayOfWeek').value = dayOfWeek;
        document.getElementById('menuType').value = mealType;
        document.getElementById('dishName').value = item ? item.dishName : '';
        document.getElementById('menuNote').value = item ? (item.note || '') : '';

        const deleteBtn = document.getElementById('deleteBtn');
        if (deleteBtn) {
            deleteBtn.style.display = (item && IS_MANAGER) ? 'block' : 'none';
        }

        setEditorDisabled(!IS_MANAGER);
    }

    async function saveMenu(e) {
        e.preventDefault();
        if (!IS_MANAGER) return;

        const payload = {
            id: parseInt(document.getElementById('menuId').value),
            dayOfWeek: parseInt(document.getElementById('menuDayOfWeek').value),
            mealType: parseInt(document.getElementById('menuType').value),
            dishName: document.getElementById('dishName').value.trim(),
            note: document.getElementById('menuNote').value.trim(),
            isActive: true
        };

        if (!payload.dishName) {
            window.showToast?.('Lỗi', 'Vui lòng nhập tên món ăn', 'error');
            return;
        }

        const resp = await fetch('/Manager/Nutrition/SaveMenu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const result = await resp.json();
        if (result.success) {
            window.showToast?.('Thành công', 'Đã lưu thực đơn', 'success');
            resetForm();
            loadWeeklyMenu();
        } else {
            window.showToast?.('Lỗi', 'Không thể lưu thực đơn', 'error');
        }
    }

    async function deleteMenu() {
        if (!IS_MANAGER) return;

        const id = parseInt(document.getElementById('menuId').value);
        if (!id) return;

        const resp = await fetch(`/Manager/Nutrition/DeleteMenu?id=${id}`, { method: 'POST' });
        const result = await resp.json();
        if (result.success) {
            window.showToast?.('Thành công', 'Đã xóa món ăn', 'success');
            resetForm();
            loadWeeklyMenu();
        } else {
            window.showToast?.('Lỗi', 'Không thể xóa món ăn', 'error');
        }
    }

    function resetForm() {
        document.getElementById('nutritionModalOverlay').classList.remove('active');
        document.getElementById('editCard').classList.remove('active');
        document.body.style.overflow = 'auto';
        setEditorDisabled(false);
        document.getElementById('menuForm').reset();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
