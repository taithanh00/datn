@model IEnumerable<datn.Models.FeeItem>
@{
    ViewData["Title"] = "Quản lý Học phí";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <style>
        .tuition-info-box {
            padding: 16px 20px;
            background: var(--bg-main);
            border-top: 1px solid var(--border);
            border-radius: 0 0 var(--radius-md) var(--radius-md);
            font-size: 0.875rem;
            line-height: 1.6;
            color: var(--text-secondary);
        }

        .tuition-info-box a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s;
            border-bottom: 1px dashed var(--primary);
        }

        .tuition-info-box a:hover {
            color: var(--primary-hover);
            border-bottom-style: solid;
        }

        .card-desc {
            line-height: 1.6;
            margin-bottom: 20px;
            color: var(--text-secondary);
        }

        .mandatory-fee-name {
            font-weight: 600;
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .price-text {
            font-weight: 700;
            color: var(--primary);
            font-size: 1rem;
        }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý & Thiết lập Học phí</h1>
        <p class="text-muted" style="font-size:0.85rem; margin-top:4px;">Điều hành quy trình thu phí và quản lý bảng giá toàn trường</p>
    </div>
    <div class="page-actions">
        <a href="/Tuition/FeeItems" class="btn btn-outline" style="border-color: var(--border-focus);">
            <i class="fa-solid fa-gears"></i> Cấu hình Danh mục Phí
        </a>
        <a href="/Tuition/Monitoring" class="btn btn-outline" style="border-color: var(--border-focus);">
            <i class="fa-solid fa-chart-line"></i> Theo dõi thu phí
        </a>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- Bảng giá học phí bắt buộc -->
    <div class="card" style="display: flex; flex-direction: column;">
        <div class="card-header" style="justify-content: space-between; padding-bottom: 16px;">
            <h3 class="card-title" style="padding-bottom: 20px;">Học phí & Khoản thu bắt buộc</h3>
            <span class="badge badge-info" style="background: var(--primary-soft); color: var(--primary);">Áp dụng tự động</span>
        </div>
        
        <div class="table-container" style="flex: 1;">
            <table id="mandatoryFeesTable">
                <thead>
                    <tr>
                        <th style="padding-left: 24px;">Tên khoản thu</th>
                        <th>Độ tuổi</th>
                        <th class="text-end" style="padding-right: 24px;">Mức phí mặc định</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">Chưa có khoản thu bắt buộc nào được thiết lập.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="mandatory-fee-name" style="padding-left: 24px;">@item.Name</td>
                                <td>
                                    @if (item.AgeFrom.HasValue || item.AgeTo.HasValue)
                                    {
                                        <span class="badge badge-outline" style="border-color: var(--border-focus);">@item.AgeFrom - @item.AgeTo tuổi</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.85rem;">Tất cả</span>
                                    }
                                </td>
                                <td class="text-end price-text" style="padding-right: 24px;">@string.Format("{0:N0}", item.DefaultAmount) đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="tuition-info-box">
            <i class="fa-solid fa-circle-info text-primary" style="margin-right: 8px; opacity: 0.8;"></i> 
            Các khoản thu này sẽ được <strong>tự động đưa vào hóa đơn</strong> dựa trên độ tuổi của từng học sinh khi khởi tạo. 
            Để thay đổi mức phí hoặc thêm mới, vui lòng vào <a href="/Tuition/FeeItems">Cấu hình Danh mục Phí</a>.
        </div>
    </div>

    <!-- Khu vực khởi tạo hóa đơn -->
    <div class="card">
        <div class="card-header" style="border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 24px;">
            <h3 class="card-title">Khởi tạo học phí tháng</h3>
        </div>
        <div style="padding: 0;">
            <div id="genAlert" style="display:none; margin-bottom: 20px;"></div>
            
            <p class="card-desc">Hệ thống sẽ quét toàn bộ danh sách học sinh và tự động tính toán hóa đơn dựa trên cấu hình giá phí hiện tại.</p>
            
            <div class="form-group mb-4">
                <label class="form-label">Chọn kỳ thu phí</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <select id="genMonth" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == DateTime.Now.Month)">Tháng @i</option>
                        }
                    </select>
                    <select id="genYear" class="form-select">
                        @for (int i = 2025; i <= 2027; i++)
                        {
                            <option value="@i" selected="@(i == DateTime.Now.Year)">Năm @i</option>
                        }
                    </select>
                </div>
            </div>

            <button class="btn btn-primary w-100" id="btnGenerate" onclick="generateTuitions()" style="padding: 12px; font-weight: 700; margin-bottom: 10px;">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Bắt đầu khởi tạo
            </button>
            
            <div class="mt-4 text-muted" style="font-size: 0.8rem; text-align: center;">
                <i class="fa-solid fa-shield-halved me-1"></i> Quá trình này có thể mất vài giây
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/tuition-plans.js" asp-append-version="true"></script>
}
