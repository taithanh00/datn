@{
    ViewData["Title"] = "Lớp của tôi";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="teacher-class-page">
    <div class="teacher-class-heading">
        <div>
            <h1 class="section-kicker">Lớp phụ trách</h1>   
            <p class="text-muted mb-0">Truy cập nhanh các nghiệp vụ hằng ngày cho lớp đang được phân công cho bạn.</p>
        </div>
        <a href="/Employee/WorkSchedule" class="btn btn-light teacher-class-heading-link" data-transition>
            <i class="fa-solid fa-calendar-days"></i>
            Lịch dạy cá nhân
        </a>
    </div>

    <div id="classesContainer" class="teacher-class-shell">
        <div class="teacher-class-loading">
            <div class="spinner"></div>
            <p class="text-muted">Đang tải lớp học của bạn...</p>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/employee-dashboard.css" asp-append-version="true" />
    <style>
        .teacher-class-page {
            width: 100%;
        }

        .teacher-class-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        .section-kicker {
            margin: 0 0 8px;
            color: var(--primary);
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .teacher-class-heading-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border-radius: 14px;
            padding: 13px 18px;
            border: 1px solid var(--border);
            color: var(--text-main);
            background: var(--bg-card);
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .teacher-class-shell {
            width: 100%;
            min-height: 420px;
        }

        .teacher-class-loading,
        .teacher-class-empty,
        .teacher-class-error {
            min-height: 420px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            border: 1px dashed var(--border);
            border-radius: 28px;
            background: var(--bg-card);
            text-align: center;
        }

        .teacher-class-overview {
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
            gap: 24px;
            align-items: stretch;
        }

        .main-class-panel {
            position: relative;
            overflow: hidden;
            min-height: 500px;
            border-radius: 30px;
            padding: 36px;
            background:
                radial-gradient(circle at 88% 14%, rgba(255, 255, 255, 0.34) 0 110px, transparent 111px),
                linear-gradient(135deg, #f91f72 0%, #ff6f9f 45%, #ffc66d 100%);
            color: #ffffff;
            box-shadow: 0 22px 45px rgba(249, 31, 114, 0.22);
        }

        .main-class-panel::after {
            content: "";
            position: absolute;
            right: -80px;
            bottom: -110px;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.18);
        }

        .main-class-content {
            position: relative;
            z-index: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 40px;
        }

        .main-class-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
        }

        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.22);
            color: #ffffff;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            backdrop-filter: blur(12px);
        }

        .main-class-title {
            margin: 20px 0 12px;
            color: #ffffff;
            font-size: clamp(2.4rem, 5vw, 5.4rem);
            line-height: 0.95;
            font-weight: 900;
            letter-spacing: -0.06em;
        }

        .main-class-subtitle {
            max-width: 680px;
            margin: 0;
            color: rgba(255, 255, 255, 0.86);
            font-size: 1.05rem;
        }

        .main-class-icon {
            width: 96px;
            height: 96px;
            border-radius: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            font-size: 2.8rem;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(14px);
            flex: 0 0 auto;
        }

        .main-class-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .main-class-stat {
            padding: 18px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.18);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(12px);
        }

        .main-class-stat span {
            display: block;
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .main-class-stat strong {
            display: block;
            margin-top: 8px;
            color: #ffffff;
            font-size: 1.65rem;
            font-weight: 900;
        }

        .teacher-action-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .teacher-action-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 22px;
            border-radius: 24px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
            text-decoration: none;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .teacher-action-card:hover {
            transform: translateY(-3px);
            border-color: rgba(249, 31, 114, 0.35);
            box-shadow: 0 18px 34px rgba(15, 23, 42, 0.1);
            color: var(--text-main);
        }

        .teacher-action-card.primary {
            background: #111827;
            color: #ffffff;
            border-color: #111827;
        }

        .teacher-action-card.primary:hover {
            color: #ffffff;
        }

        .teacher-action-icon {
            width: 54px;
            height: 54px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffe4ef;
            color: var(--primary);
            font-size: 1.2rem;
            flex: 0 0 auto;
        }

        .teacher-action-card.primary .teacher-action-icon {
            background: rgba(255, 255, 255, 0.14);
            color: #ffffff;
        }

        .teacher-action-copy {
            flex: 1;
            min-width: 0;
        }

        .teacher-action-copy strong {
            display: block;
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .teacher-action-copy span {
            display: block;
            color: var(--text-muted);
            font-size: 0.86rem;
        }

        .teacher-action-card.primary .teacher-action-copy span {
            color: rgba(255, 255, 255, 0.72);
        }

        .teacher-action-arrow {
            color: var(--text-muted);
        }

        .teacher-secondary-classes {
            grid-column: 1 / -1;
            border-radius: 24px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 22px;
        }

        .teacher-secondary-classes h3 {
            margin: 0 0 14px;
            font-size: 1rem;
        }

        .teacher-secondary-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .teacher-secondary-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid var(--border);
            color: var(--text-main);
            font-weight: 700;
            font-size: 0.86rem;
        }

        @@media (max-width: 1100px) {
            .teacher-class-overview {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .teacher-class-heading,
            .main-class-top {
                flex-direction: column;
            }

            .teacher-class-heading-link {
                width: 100%;
                justify-content: center;
            }

            .main-class-panel {
                min-height: auto;
                padding: 26px;
                border-radius: 24px;
            }

            .main-class-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadMyClasses();
        });

        async function loadMyClasses() {
            try {
                const response = await fetch('/Employee/Api/MyClasses');
                const result = await response.json();
                
                const container = document.getElementById('classesContainer');
                if (!container) return;
                
                if (result.success) {
                    const classes = Array.isArray(result.data) ? result.data : [];

                    if (classes.length === 0) {
                        container.innerHTML = `
                            <div class="teacher-class-empty">
                                <i class="fa-solid fa-circle-info" style="font-size:2.4rem; color:var(--primary);"></i>
                                <div>
                                    <h3 class="mb-1">Chưa có lớp phụ trách</h3>
                                    <p class="text-muted mb-0">Bạn chưa được phân công vào lớp học nào.</p>
                                </div>
                            </div>
                        `;
                        return;
                    }

                    const mainClass = classes[0];
                    const secondaryClasses = classes.slice(1);

                    container.innerHTML = `
                        <div class="teacher-class-overview">
                            <section class="main-class-panel">
                                <div class="main-class-content">
                                    <div class="main-class-top">
                                        <div>
                                            <span class="role-pill">
                                                <i class="fa-solid fa-user-check"></i>
                                                ${escapeHtml(mainClass.role || 'Giáo viên phụ trách')}
                                            </span>
                                            <h2 class="main-class-title">${escapeHtml(mainClass.className)}</h2>
                                            <p class="main-class-subtitle">Đây là lớp đang được phân công cho bạn.</p>
                                        </div>
                                        <div class="main-class-icon" aria-hidden="true">
                                            <i class="fa-solid fa-school"></i>
                                        </div>
                                    </div>

                                    <div class="main-class-stats">
                                        <div class="main-class-stat">
                                            <span>Sĩ số</span>
                                            <strong>${Number(mainClass.studentCount || 0)} học sinh</strong>
                                        </div>
                                        <div class="main-class-stat">
                                            <span>Vai trò</span>
                                            <strong>${escapeHtml(mainClass.role || 'N/A')}</strong>
                                        </div>
                                        <div class="main-class-stat">
                                            <span>Mã lớp</span>
                                            <strong>#${mainClass.classId}</strong>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <aside class="teacher-action-panel">
                                <a href="/Employee/Attendance?classId=${mainClass.classId}" class="teacher-action-card primary" data-transition>
                                    <div class="teacher-action-icon"><i class="fa-solid fa-calendar-check"></i></div>
                                    <div class="teacher-action-copy">
                                        <strong>Điểm danh hôm nay</strong>
                                        <span>Ghi nhận chuyên cần cho lớp ${escapeHtml(mainClass.className)}</span>
                                    </div>
                                    <i class="fa-solid fa-arrow-right teacher-action-arrow"></i>
                                </a>

                                <a href="/Employee/WorkSchedule?classId=${mainClass.classId}" class="teacher-action-card" data-transition>
                                    <div class="teacher-action-icon"><i class="fa-solid fa-list-ul"></i></div>
                                    <div class="teacher-action-copy">
                                        <strong>Xem danh sách lớp</strong>
                                        <span>Thông tin học sinh và lịch làm việc liên quan</span>
                                    </div>
                                    <i class="fa-solid fa-arrow-right teacher-action-arrow"></i>
                                </a>

                                <a href="/Employee/StudyReport?classId=${mainClass.classId}" class="teacher-action-card" data-transition>
                                    <div class="teacher-action-icon"><i class="fa-solid fa-file-signature"></i></div>
                                    <div class="teacher-action-copy">
                                        <strong>Nhận xét & báo cáo</strong>
                                        <span>Cập nhật đánh giá học tập cho học sinh</span>
                                    </div>
                                    <i class="fa-solid fa-arrow-right teacher-action-arrow"></i>
                                </a>

                                <a href="/Employee/ClassReports?classId=${mainClass.classId}" class="teacher-action-card" data-transition>
                                    <div class="teacher-action-icon"><i class="fa-solid fa-book-open"></i></div>
                                    <div class="teacher-action-copy">
                                        <strong>Nhật ký lớp học</strong>
                                        <span>Ghi nhận ăn, ngủ, sức khỏe và hoạt động trong ngày</span>
                                    </div>
                                    <i class="fa-solid fa-arrow-right teacher-action-arrow"></i>
                                </a>
                            </aside>

                            ${secondaryClasses.length ? renderSecondaryClasses(secondaryClasses) : ''}
                        </div>
                    `;
                } else {
                    container.innerHTML = `
                        <div class="teacher-class-error">
                            <i class="fa-solid fa-triangle-exclamation" style="font-size:2.4rem; color:var(--danger);"></i>
                            <div>
                                <h3 class="mb-1">Không tải được lớp học</h3>
                                <p class="text-muted mb-0">Lỗi: ${escapeHtml(result.message || 'Không xác định')}</p>
                            </div>
                        </div>
                    `;
                }
            } catch (error) {
                console.error("Lỗi khi tải danh sách lớp:", error);
                const container = document.getElementById('classesContainer');
                if (container) {
                    container.innerHTML = `
                        <div class="teacher-class-error">
                            <i class="fa-solid fa-wifi" style="font-size:2.4rem; color:var(--danger);"></i>
                            <div>
                                <h3 class="mb-1">Không kết nối được dữ liệu</h3>
                                <p class="text-muted mb-0">Vui lòng tải lại trang hoặc kiểm tra kết nối tới máy chủ.</p>
                            </div>
                        </div>
                    `;
                }
            }
        }

        function renderSecondaryClasses(classes) {
            return `
                <section class="teacher-secondary-classes">
                    <h3>Lớp phụ khác</h3>
                    <div class="teacher-secondary-list">
                        ${classes.map(item => `
                            <span class="teacher-secondary-chip">
                                <i class="fa-solid fa-school"></i>
                                ${escapeHtml(item.className)} · ${Number(item.studentCount || 0)} học sinh
                            </span>
                        `).join('')}
                    </div>
                </section>
            `;
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }
    </script>
}

