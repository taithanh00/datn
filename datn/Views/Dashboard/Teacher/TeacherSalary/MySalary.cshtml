@model IEnumerable<datn.Models.Salary>
@{
    ViewData["Title"] = "Lương của tôi";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Lương của tôi</h1>
        <p class="text-muted" style="font-size:0.9rem; margin-top:4px;">Theo dõi phiếu lương đã chốt và trạng thái thanh toán.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state py-5">
            <i class="fa-solid fa-box-open"></i>
            <p>Bạn chưa có phiếu lương đã chốt trong hệ thống.</p>
        </div>
    </div>
}
else
{
    <div class="salary-card-grid">
        @foreach (var s in Model)
        {
            var statusText = s.Status == datn.Models.SalaryStatus.Paid ? "Đã thanh toán" : "Đã chốt";
            var statusClass = s.Status == datn.Models.SalaryStatus.Paid ? "badge-success" : "badge-info";
            <div class="salary-card">
                <div class="salary-card-top">
                    <div>
                        <span class="text-muted">Kỳ lương</span>
                        <h3>Tháng @s.PayrollPeriod.Month/@s.PayrollPeriod.Year</h3>
                    </div>
                    <span class="badge @statusClass">@statusText</span>
                </div>
                <div class="salary-amount">@string.Format("{0:N0}", s.SalaryAmount) đ</div>
                <div class="salary-meta">
                    <span><i class="fa-regular fa-calendar-check"></i> @(s.WorkingDays ?? 0) công</span>
                    <span><i class="fa-solid fa-money-check-dollar"></i> @(s.PaymentMethod ?? "Chưa ghi nhận thanh toán")</span>
                </div>
                <a asp-action="SalarySlip" asp-route-employeeId="@s.EmployeeId" asp-route-periodId="@s.PayrollPeriodId" class="btn btn-primary" style="justify-content:center;">
                    <i class="fa-solid fa-file-invoice"></i> Xem phiếu lương
                </a>
            </div>
        }
    </div>
}

@section Styles {
    <style>
        .salary-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
        .salary-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 22px; padding: 22px; box-shadow: var(--shadow-sm); }
        .salary-card-top { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
        .salary-card h3 { margin: 6px 0 0; font-size: 1.2rem; }
        .salary-amount { margin: 28px 0 18px; font-size: 2rem; font-weight: 900; color: var(--primary); }
        .salary-meta { display: grid; gap: 8px; color: var(--text-muted); margin-bottom: 20px; }
        .salary-meta span { display: flex; gap: 8px; align-items: center; }
    </style>
}
