@model datn.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
    var isEmployee = Model?.Role == "Employee" || Model?.Role == "Manager";
    var isParent = Model?.Role == "Parent";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/profile.css" asp-append-version="true" />
}

<div class="profile-container">
    <form method="post" enctype="multipart/form-data" action="/Account/Profile" style="display: contents;">
        <!-- Sidebar: Avatar & Basic Info -->
        <aside class="profile-sidebar">
            <div class="profile-avatar-card">
                <div class="avatar-wrapper">
                    <img id="avatarPreview" src="@ViewBag.UserAvatar" alt="Avatar" class="avatar-image" onerror="this.src='/images/lion_blue.png'" />
                    <label for="avatarInput" class="avatar-edit-btn" title="Đổi ảnh đại diện">
                        <i class="fa-solid fa-camera"></i>
                    </label>
                    <input type="file" id="avatarInput" name="AvatarFile" accept="image/*" style="display: none;" onchange="previewAvatar(this)" />
                </div>
                <h2 class="profile-name">@ViewBag.FullName</h2>
                <div class="profile-role-badge">
                    @(isEmployee ? "Giáo viên" : isParent ? "Phụ huynh" : "Quản lý")
                </div>
                <p class="text-muted mt-2" style="font-size: 0.85rem;">@@@ViewBag.Username</p>
            </div>
        </aside>

        <!-- Main Content: Detailed Forms -->
        <main class="profile-main-content">
            @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
            {
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>@ViewBag.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.ErrorMessage</span>
                </div>
            }

            <!-- Section: Account Settings -->
            <div class="profile-form-card mb-4">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fa-solid fa-shield-halved"></i> Thông tin tài khoản
                    </h3>
                    <a href="/Account/ChangePassword" class="btn btn-outline btn-sm">
                        <i class="fa-solid fa-key"></i> Đổi mật khẩu
                    </a>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" value="@Model?.Username" class="form-input" disabled />
                        <small class="text-muted">Tên đăng nhập được cố định</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email liên hệ</label>
                        <input type="email" name="Email" value="@Model?.Email" class="form-input" placeholder="example@gmail.com" />
                    </div>
                </div>
            </div>

            <!-- Section: Personal Details -->
            @if (isEmployee)
            {
                <div class="profile-form-card mb-4">
                    <div class="section-header">
                        <h3 class="section-title">
                            <i class="fa-solid fa-user-tie"></i> Thông tin cá nhân
                        </h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Họ đệm</label>
                            <input type="text" name="LastName" value="@Model?.LastName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tên</label>
                            <input type="text" name="FirstName" value="@Model?.FirstName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Số điện thoại</label>
                            <input type="tel" name="Phone" value="@Model?.Phone" class="form-input" />
                        </div>
                        <div class="form-group form-full">
                            <label class="form-label">Vị trí / Chức vụ</label>
                            <input type="text" name="Position" value="@Model?.Position" class="form-input" />
                        </div>
                    </div>
                </div>
            }

            @if (isParent)
            {
                <div class="profile-form-card mb-4">
                    <div class="section-header">
                        <h3 class="section-title">
                            <i class="fa-solid fa-user-group"></i> Thông tin phụ huynh
                        </h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Họ</label>
                            <input type="text" name="LastName" value="@Model?.LastName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tên</label>
                            <input type="text" name="FirstName" value="@Model?.FirstName" class="form-input" />
                        </div>
                        <div class="form-group form-full">
                            <label class="form-label">Số điện thoại</label>
                            <input type="tel" name="Phone" value="@Model?.Phone" class="form-input" />
                        </div>
                        <div class="form-group form-full">
                            <label class="form-label">Địa chỉ thường trú</label>
                            <textarea name="Address" class="form-input" rows="3">@Model?.Address</textarea>
                        </div>
                    </div>
                </div>
            }

            <!-- Profile Actions -->
            <div class="profile-footer">
                <a href="/" class="btn btn-outline">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
                </button>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Tự động ẩn thông báo sau 5 giây
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.opacity = '0';
                    alert.style.transform = 'translateY(-10px)';
                    alert.style.transition = 'all 0.5s ease';
                    setTimeout(() => alert.remove(), 500);
                }, 5000);
            });
        });
    </script>
}
