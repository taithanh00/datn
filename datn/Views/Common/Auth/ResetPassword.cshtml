@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
    var token = ViewBag.Token as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sen Hồng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/pages/login.css")" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .requirement-list {
            margin-top: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .requirement {
            font-size: 0.85rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94a3b8;
        }

        .requirement i {
            font-size: 0.95rem;
        }

        .requirement.valid {
            color: #10b981;
        }

        .requirement.valid i {
            color: #10b981;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-card">
            <div class="left-panel" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; color: white; text-align: center; padding: 20px;">
                <div>
                    <i class="fa-solid fa-key-skeleton" style="font-size: 5rem; margin-bottom: 20px; opacity: 0.8;"></i>
                    <h2 style="font-weight: 800; margin-bottom: 10px;">Mật khẩu mới</h2>
                    <p style="opacity: 0.9; font-size: 0.9rem;">Hãy thiết lập một mật khẩu mạnh để bảo vệ tài khoản của bạn tốt hơn.</p>
                </div>
            </div>

            <div class="right-panel">
                <h2 class="form-title">Đặt lại mật khẩu</h2>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-xmark"></i> @ViewBag.Error
                    </div>
                }

                <form method="post" action="/Auth/ResetPassword">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@token" />

                    <div class="field-group">
                        <label for="password">Mật khẩu mới</label>
                        <input type="password" id="password" name="password" placeholder="••••••••" required />
                        
                        <div class="requirement-list">
                            <div id="req-length" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 9 ký tự</div>
                            <div id="req-upper" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 1 chữ hoa</div>
                            <div id="req-special" class="requirement"><i class="fa-solid fa-circle-dot"></i> Ít nhất 1 ký tự đặc biệt</div>
                        </div>
                    </div>

                    <div class="field-group" style="margin-top: 20px;">
                        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required />
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-login" style="margin-top: 20px; opacity: 0.5; cursor: not-allowed;" disabled>
                        Xác nhận thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirmPassword');
        const btnSubmit = document.getElementById('btnSubmit');

        const reqLength = document.getElementById('req-length');
        const reqUpper = document.getElementById('req-upper');
        const reqSpecial = document.getElementById('req-special');

        function validate() {
            const val = passwordInput.value;
            const confirmVal = confirmInput.value;

            const isLength = val.length >= 9;
            const isUpper = /[A-Z]/.test(val);
            const isSpecial = /[!@@#$%^&*()_+=\-\[\]{}|;:'",.<>?/\\ ]/.test(val);
            const isMatch = val === confirmVal && val !== '';

            updateUI(reqLength, isLength);
            updateUI(reqUpper, isUpper);
            updateUI(reqSpecial, isSpecial);

            if (isLength && isUpper && isSpecial && isMatch) {
                btnSubmit.disabled = false;
                btnSubmit.style.opacity = '1';
                btnSubmit.style.cursor = 'pointer';
            } else {
                btnSubmit.disabled = true;
                btnSubmit.style.opacity = '0.5';
                btnSubmit.style.cursor = 'not-allowed';
            }
        }

        function updateUI(el, isValid) {
            const icon = el.querySelector('i');
            if (isValid) {
                el.classList.add('valid');
                icon.className = 'fa-solid fa-circle-check';
            } else {
                el.classList.remove('valid');
                icon.className = 'fa-solid fa-circle-dot';
            }
        }

        passwordInput.addEventListener('input', validate);
        confirmInput.addEventListener('input', validate);
    </script>
</body>
</html>
