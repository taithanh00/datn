@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Views/Common/Shared/_DashboardLayout.cshtml";
    var role = ViewBag.Role as string ?? "";
}

@if (role == "Manager")
{
    <div class="stats-grid">
        <div class="card stat-card">
            <div class="stat-title">Tổng học sinh</div>
            <div class="stat-value" id="totalStudents">--</div>
        </div>
        <div class="card stat-card">
            <div class="stat-title">Giáo viên / Nhân viên</div>
            <div class="stat-value" id="totalEmployees">--</div>
        </div>
        <div class="card stat-card">
            <div class="stat-title">Chấm công chờ duyệt</div>
            <div class="stat-value text-warning" id="pendingAttendanceCount">0</div>
        </div>
        <div class="card stat-card">
            <div class="stat-title">Đơn nghỉ phép chờ duyệt</div>
            <div class="stat-value text-primary" id="pendingLeaveCount">0</div>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom:16px;">Hoạt động hệ thống</h3>
        <p id="managerRealtimeStatus" class="text-muted" style="font-size:0.85rem;">Đang kết nối realtime...</p>
    </div>
}

@if (role == "Employee")
{
    <div class="stats-grid">
        <div class="card stat-card">
            <div class="stat-title">Lớp phụ trách</div>
            <div class="stat-value" id="myClassCount">--</div>
        </div>
        <div class="card stat-card">
            <div class="stat-title">Trạng thái chấm công hôm nay</div>
            <div class="stat-value" id="todayCheckStatus">Chưa check-in</div>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom:16px;">Chào mừng trở lại!</h3>
        <p class="text-muted">Sử dụng menu bên trái để điểm danh, xem lịch dạy hoặc quản lý chấm công cá nhân.</p>
    </div>
}

@if (role == "Parent")
{
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Chào buổi sáng" : hour < 18 ? "Chào buổi chiều" : "Chào buổi tối";

    <div class="welcome-banner parent-home-hero">
        <div class="parent-home-hero__content">
            <h2 class="parent-home-hero__title">@greeting, @ViewBag.FullName! 👋</h2>
            <p class="parent-home-hero__text">Chào mừng bạn đến với Cổng thông tin Phụ huynh. Hãy theo dõi hành trình học tập và phát triển của bé yêu mỗi ngày.</p>
        </div>
        <div class="parent-home-hero__orb parent-home-hero__orb--lg"></div>
        <div class="parent-home-hero__orb parent-home-hero__orb--sm"></div>
    </div>

    <div class="stats-grid" id="parentDashboardGrid" style="margin-bottom: 32px;">
        <div class="card stat-card" style="border-left: 4px solid var(--primary); transform: translateY(0); transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <div class="stat-title" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-children text-primary"></i> Bé đang học</div>
            <div class="stat-value" id="parentChildrenCount">--</div>
        </div>
        <div class="card stat-card" style="border-left: 4px solid var(--danger); transform: translateY(0); transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'" onclick="window.location.href='/Tuition/MyTuition'">
            <div class="stat-title" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-file-invoice-dollar text-danger"></i> Hóa đơn chờ thanh toán</div>
            <div class="stat-value text-danger" id="parentTuitionCount">--</div>
        </div>
        <div class="card stat-card" style="border-left: 4px solid var(--success); transform: translateY(0); transition: transform 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'" onclick="window.location.href='/Parent/AttendanceReport'">
            <div class="stat-title" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-calendar-check text-success"></i> Điểm danh hôm nay</div>
            <div class="stat-value" id="parentAttendanceStatus" style="font-size: 1.2rem;">Đang tải...</div>
        </div>
    </div>

    <h3 style="margin-bottom: 20px; font-weight: 600; font-size: 1.4rem; color: var(--text-main);">Truy cập nhanh</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;">
        <a href="/DailyReport/MyChild" class="quick-access-card" style="background: white; border-radius: 16px; padding: 24px; text-align: center; text-decoration: none; color: var(--text-main); box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease; display: block;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.05)'">
            <div style="width: 60px; height: 60px; background: rgba(232, 62, 140, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
                <i class="fa-solid fa-notes-medical" style="font-size: 24px; color: var(--primary);"></i>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 4px;">Sức khỏe</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Xem nhật ký</p>
        </a>

        <a href="/Tuition/MyTuition" class="quick-access-card" style="background: white; border-radius: 16px; padding: 24px; text-align: center; text-decoration: none; color: var(--text-main); box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease; display: block;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.05)'">
            <div style="width: 60px; height: 60px; background: rgba(255, 193, 7, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
                <i class="fa-solid fa-wallet" style="font-size: 24px; color: var(--warning);"></i>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 4px;">Học phí</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Thanh toán</p>
        </a>

        <a href="/Parent/Activities" class="quick-access-card" style="background: white; border-radius: 16px; padding: 24px; text-align: center; text-decoration: none; color: var(--text-main); box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease; display: block;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.05)'">
            <div style="width: 60px; height: 60px; background: rgba(13, 110, 253, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
                <i class="fa-solid fa-puzzle-piece" style="font-size: 24px; color: var(--info);"></i>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 4px;">Sự kiện</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Ngoại khóa</p>
        </a>
    </div>
}

@section Styles {
    <style>
        .parent-home-hero {
            position: relative;
            overflow: hidden;
            padding: 32px;
            margin-bottom: 24px;
            border-radius: 20px;
            border: 1px solid rgba(233, 30, 99, 0.14);
            background:
                radial-gradient(circle at top right, rgba(255, 255, 255, 0.72), transparent 42%),
                linear-gradient(135deg, #fff6fa 0%, #ffe7f0 52%, #ffd9e7 100%);
            box-shadow: 0 12px 30px rgba(233, 30, 99, 0.12);
            color: var(--text-main);
        }

        .parent-home-hero__content {
            position: relative;
            z-index: 2;
            max-width: 700px;
        }

        .parent-home-hero__title {
            margin: 0 0 10px;
            font-size: clamp(1.5rem, 3vw, 2rem);
            line-height: 1.25;
            font-weight: 800;
            color: var(--text-main);
            text-shadow: none;
        }

        .parent-home-hero__text {
            margin: 0;
            max-width: 620px;
            font-size: 1.05rem;
            line-height: 1.7;
            color: var(--text-secondary);
        }

        .parent-home-hero__orb {
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
            background: rgba(233, 30, 99, 0.08);
            filter: blur(10px);
        }

        .parent-home-hero__orb--lg {
            width: 220px;
            height: 220px;
            top: -70px;
            right: -60px;
        }

        .parent-home-hero__orb--sm {
            width: 120px;
            height: 120px;
            right: 90px;
            bottom: -40px;
            filter: blur(8px);
        }

        :root[data-theme="dark"] .parent-home-hero {
            border-color: rgba(240, 98, 146, 0.22);
            background:
                radial-gradient(circle at top right, rgba(240, 98, 146, 0.24), transparent 42%),
                linear-gradient(135deg, rgba(240, 98, 146, 0.22) 0%, rgba(88, 86, 214, 0.22) 100%);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
            color: var(--text-main);
        }

        :root[data-theme="dark"] .parent-home-hero__title,
        :root[data-theme="dark"] .parent-home-hero__text {
            color: var(--text-main);
        }

        :root[data-theme="dark"] .parent-home-hero__orb {
            background: rgba(255, 255, 255, 0.07);
        }

        @@media (max-width: 768px) {
            .parent-home-hero {
                padding: 24px;
            }

            .parent-home-hero__text {
                font-size: 1rem;
            }
        }
    </style>
}

@section Scripts {
    <script src="~/js/pages/home-index.js" asp-append-version="true"></script>
}
